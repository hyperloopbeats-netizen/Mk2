<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>AIM FIGHT - 4-Zone Mortal Ninja Kombat</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        * { box-sizing: border-box; }
        body { 
            background-color: #07070b; 
            color: #f1f5f9; 
            font-family: monospace; 
            overflow: hidden; 
            touch-action: none; 
            user-select: none;
            -webkit-user-select: none;
            margin: 0;
            padding: 0;
            height: 100vh;
            height: 100dvh;
        }
        canvas { 
            background: #0a0914; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.9);
            width: 100%;
            height: 100%;
            display: block;
            image-rendering: pixelated;
        }
        .snes-btn {
            background: #1e293b;
            border-radius: 50%;
            box-shadow: 0 4px 6px rgba(0,0,0,0.5), inset 0 1px 2px rgba(255,255,255,0.2);
            border: 1px solid #475569;
            font-weight: bold;
            touch-action: none;
        }
        .snes-btn:active, .snes-btn.active {
            transform: scale(0.92);
            background: #0f172a;
        }
        .crt-scanlines::before {
            content: " ";
            display: block;
            position: absolute;
            inset: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%);
            background-size: 100% 3px;
            pointer-events: none;
            opacity: 0.75;
            z-index: 10;
        }
    </style>
</head>
<body class="flex flex-col justify-between items-center h-screen h-[100dvh] max-h-[100dvh] p-1 overflow-hidden select-none touch-none">

    <!-- Top Retro HUD -->
    <header class="w-full max-w-4xl flex justify-between items-center px-3 py-1 bg-zinc-950 border border-zinc-800 rounded-lg text-xs shrink-0">
        <div class="flex items-center gap-2">
            <span class="text-red-500 font-black tracking-wider text-[11px]">AIM FIGHT [4-ZONE]</span>
            <span id="matchBanner" class="text-amber-400 font-bold text-[11px]">ROUND 1</span>
        </div>
        <div id="telemetryStatus" class="flex gap-3 text-zinc-300 text-[10px]">
            <span>SMOKE: <strong id="p1HpText" class="text-emerald-400">100%</strong></span>
            <span>TIME: <strong id="timerText" class="text-amber-400">99</strong></span>
            <span>SCORPION: <strong id="cpuHpText" class="text-emerald-400">100%</strong></span>
        </div>
        <div class="flex items-center gap-1.5">
            <button id="toggleColliderBtn" onclick="toggleColliders()" class="px-2 py-0.5 bg-zinc-800 text-zinc-300 rounded text-[9px] font-bold">BOX: OFF</button>
            <button id="autoToggleBtn" onclick="toggleAuto()" class="px-2 py-0.5 bg-purple-600 text-white rounded font-bold text-[9px]">AUTO: ON</button>
        </div>
    </header>

    <!-- 4-Zone Paperdoll Mini Bar -->
    <div class="w-full max-w-4xl flex justify-between items-center px-3 py-0.5 bg-zinc-950/80 border-x border-b border-zinc-800 text-[9px] shrink-0">
        <div id="p1Paperdoll" class="flex items-center gap-1.5">
            <span class="text-slate-300 font-bold">SMOKE:</span>
            <span id="p1Head" class="text-emerald-400">H:100%</span>
            <span id="p1Torso" class="text-emerald-400">T:100%</span>
            <span id="p1LLimb" class="text-emerald-400">L:100%</span>
            <span id="p1RLimb" class="text-emerald-400">R:100%</span>
        </div>
        <div id="cpuPaperdoll" class="flex items-center gap-1.5">
            <span id="cpuRLimb" class="text-emerald-400">R:100%</span>
            <span id="cpuLLimb" class="text-emerald-400">L:100%</span>
            <span id="cpuTorso" class="text-emerald-400">T:100%</span>
            <span id="cpuHead" class="text-emerald-400">H:100%</span>
            <span class="text-yellow-400 font-bold">:SCORPION</span>
        </div>
    </div>

    <!-- Canvas Viewport with Cinematic Zoom -->
    <main class="relative w-full max-w-4xl flex-1 min-h-0 my-0.5 crt-scanlines overflow-hidden rounded-lg border border-zinc-800 bg-zinc-950 flex items-center justify-center">
        <canvas id="gameCanvas" width="960" height="540" class="w-full h-full object-contain"></canvas>
    </main>

    <!-- Multitouch Onscreen Controller (Authentic SNES Layout) -->
    <footer class="w-full max-w-4xl bg-gradient-to-t from-zinc-950 via-zinc-900/95 to-zinc-950 border-t border-zinc-800/90 px-3 sm:px-6 pt-1 pb-2 flex flex-col justify-between shrink-0 touch-none select-none">
        <!-- Shoulder Bumpers: [ L GUARD ] and [ R SUPER ] -->
        <div class="w-full flex justify-between items-center px-1 mb-1">
            <button id="btnGuard" class="px-4 py-1.5 rounded-full font-mono text-[10px] sm:text-xs font-black bg-zinc-900 border border-cyan-700 text-cyan-300 shadow active:scale-95 touch-none">🛡 L: GUARD</button>
            <div class="text-[8px] text-zinc-500 font-mono uppercase tracking-widest">SNES MULTITOUCH</div>
            <button id="btnSuper" class="px-4 py-1.5 rounded-full font-bold text-[9px] sm:text-[10px] bg-gradient-to-r from-amber-500 to-yellow-400 text-zinc-950 border border-amber-300 shadow active:scale-95 touch-none">⚡ R: SUPER</button>
        </div>

        <div class="w-full flex items-center justify-between px-1">
            <!-- Left: Multitouch Thumbstick -->
            <div id="touchStickContainer" class="relative w-24 h-24 sm:w-28 sm:h-28 rounded-full bg-zinc-900 border-2 border-zinc-700 flex items-center justify-center touch-none cursor-pointer">
                <span class="absolute top-1 text-[8px] text-zinc-500 font-bold pointer-events-none">▲</span>
                <span class="absolute bottom-1 text-[8px] text-zinc-500 font-bold pointer-events-none">▼</span>
                <span class="absolute left-1 text-[8px] text-zinc-500 font-bold pointer-events-none">◀</span>
                <span class="absolute right-1 text-[8px] text-zinc-500 font-bold pointer-events-none">▶</span>
                <div id="stickKnob" class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-cyan-700 border border-cyan-400 shadow-lg pointer-events-none transition-transform duration-75"></div>
            </div>

            <!-- Mid Torso Button -->
            <button id="btnMid" class="w-11 h-11 rounded-full bg-zinc-900 border-2 border-purple-500 flex flex-col items-center justify-center shadow active:scale-90 touch-none">
                <span class="text-[10px] font-black text-purple-300">MID</span>
                <span class="text-[6px] text-zinc-400">TORSO</span>
            </button>

            <!-- Authentic Angled SNES Diamond Cluster -->
            <div class="relative w-36 h-28 sm:w-40 sm:h-32 flex items-center justify-center touch-none transform -rotate-12 origin-center">
                <button id="btnX" class="absolute top-0 left-12 w-11 h-11 rounded-full border-2 border-blue-400 bg-gradient-to-b from-blue-600 to-blue-800 text-white font-bold flex flex-col items-center justify-center shadow active:scale-90 touch-none"><span class="text-xs leading-none">X</span><span class="text-[6px] text-blue-200">HEAD</span></button>
                <button id="btnY" class="absolute top-8 left-1 w-11 h-11 rounded-full border-2 border-emerald-400 bg-gradient-to-b from-emerald-600 to-emerald-800 text-white font-bold flex flex-col items-center justify-center shadow active:scale-90 touch-none"><span class="text-xs leading-none">Y</span><span class="text-[6px] text-emerald-200">JAB</span></button>
                <button id="btnA" class="absolute top-8 right-1 w-11 h-11 rounded-full border-2 border-red-400 bg-gradient-to-b from-red-600 to-red-800 text-white font-bold flex flex-col items-center justify-center shadow active:scale-90 touch-none"><span class="text-xs leading-none">A</span><span class="text-[6px] text-red-200">ARM</span></button>
                <button id="btnB" class="absolute bottom-0 left-12 w-11 h-11 rounded-full border-2 border-yellow-300 bg-gradient-to-b from-yellow-500 to-yellow-700 text-zinc-950 font-bold flex flex-col items-center justify-center shadow active:scale-90 touch-none"><span class="text-xs leading-none">B</span><span class="text-[6px] text-zinc-900">SWEEP</span></button>
            </div>
        </div>
    </footer>

    <script>
        // PROCEDURAL AUDIO SYNTHESIZER
        let audioCtx = null;
        function initAudio() {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            if (audioCtx.state === 'suspended') audioCtx.resume();
        }
        window.addEventListener('pointerdown', initAudio, { once: true });
        window.addEventListener('keydown', initAudio, { once: true });

        const RetroAudio = {
            playHit(type = 'light') {
                if (!audioCtx) return;
                const t = audioCtx.currentTime;
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                if (type === 'heavy') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(160, t);
                    osc.frequency.exponentialRampToValueAtTime(30, t + 0.2);
                    gain.gain.setValueAtTime(0.4, t);
                    gain.gain.exponentialRampToValueAtTime(0.01, t + 0.2);
                } else if (type === 'crack') {
                    osc.type = 'square';
                    osc.frequency.setValueAtTime(400, t);
                    osc.frequency.exponentialRampToValueAtTime(60, t + 0.15);
                    gain.gain.setValueAtTime(0.5, t);
                    gain.gain.exponentialRampToValueAtTime(0.01, t + 0.15);
                } else {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(240, t);
                    osc.frequency.exponentialRampToValueAtTime(50, t + 0.08);
                    gain.gain.setValueAtTime(0.3, t);
                    gain.gain.exponentialRampToValueAtTime(0.01, t + 0.08);
                }
                osc.connect(gain); gain.connect(audioCtx.destination);
                osc.start(t); osc.stop(t + (type === 'heavy' ? 0.2 : 0.08));
            },
            playBlock() {
                if (!audioCtx) return;
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(600, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(150, audioCtx.currentTime + 0.09);
                gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.09);
                osc.connect(gain); gain.connect(audioCtx.destination);
                osc.start(t); osc.stop(audioCtx.currentTime + 0.09);
            }
        };

        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const TARGET_FPS = 120;
        const FIXED_DT = 1.0 / TARGET_FPS;

        let autoBattle = true;
        let showColliders = false;
        function toggleAuto() {
            autoBattle = !autoBattle;
            const b = document.getElementById('autoToggleBtn');
            b.textContent = 'AUTO: ' + (autoBattle ? 'ON' : 'OFF');
            b.className = 'px-2 py-0.5 rounded font-bold text-[9px] ' + (autoBattle ? 'bg-purple-600 text-white' : 'bg-zinc-800 text-zinc-400');
        }
        function toggleColliders() {
            showColliders = !showColliders;
            document.getElementById('toggleColliderBtn').textContent = 'BOX: ' + (showColliders ? 'ON' : 'OFF');
        }

        // CINEMATIC CAMERA
        const camera = { x: 480, y: 350, zoom: 1.25, hitZoom: 0 };

        // 4-ZONE FIGHTER CLASS
        class Fighter {
            constructor(name, x, facing, mass, color) {
                this.name = name;
                this.x = x;
                this.y = 350;
                this.vx = 0;
                this.vy = 0;
                this.width = 52;
                this.height = 96;
                this.facing = facing;
                this.mass = mass;
                this.color = color;
                this.hp = 100;
                this.superMeter = 0;
                this.isGrounded = true;

                this.zones = {
                    HEAD: { hp: 100, isBroken: false },
                    TORSO: { hp: 100, isBroken: false },
                    LEFT_LIMBS: { hp: 100, isBroken: false },
                    RIGHT_LIMBS: { hp: 100, isBroken: false }
                };

                this.state = 'IDLE';
                this.actionFrame = 0;
                this.currentAttack = null;
                this.activeHitbox = null;
                this.hitStop = 0;
            }

            getStatus() {
                const headRatio = this.zones.HEAD.hp / 100;
                const torsoRatio = this.zones.TORSO.hp / 100;
                const leftRatio = this.zones.LEFT_LIMBS.hp / 100;
                const rightRatio = this.zones.RIGHT_LIMBS.hp / 100;

                return {
                    concussed: this.zones.HEAD.hp <= 45,
                    torsoBreached: this.zones.TORSO.hp <= 40,
                    legCrippled: this.zones.LEFT_LIMBS.hp <= 40,
                    armFractured: this.zones.RIGHT_LIMBS.hp <= 40,
                    baseSpeedMultiplier: Math.max(0.48, 1.0 - (1 - leftRatio) * 0.42 - (1 - torsoRatio) * 0.18),
                    returnToBaseMultiplier: Math.min(1.65, 1.0 + (1 - headRatio) * 0.25 + (1 - torsoRatio) * 0.20 + (1 - rightRatio) * 0.20)
                };
            }

            getHurtboxes() {
                const isCrouch = this.state === 'CROUCH';
                const h = isCrouch ? this.height * 0.65 : this.height;
                const top = isCrouch ? this.y + (this.height - h) : this.y;
                return {
                    HEAD: { x: this.x + 10, y: top, width: 32, height: h * 0.25 },
                    TORSO: { x: this.x + 8, y: top + h * 0.25, width: 36, height: h * 0.4 },
                    LEFT_LIMBS: { x: this.x + (this.facing === 1 ? 0 : 26), y: top + h * 0.65, width: 26, height: h * 0.35 },
                    RIGHT_LIMBS: { x: this.x + (this.facing === 1 ? 26 : 0), y: top + h * 0.65, width: 26, height: h * 0.35 }
                };
            }

            attack(type) {
                if (this.state === 'ATTACK' || this.state === 'HITSTUN') return;
                const status = this.getStatus();
                const startupPen = status.armFractured ? 3 : 0;

                this.state = 'ATTACK';
                this.actionFrame = 0;

                if (type === 'HEAD_JAB') {
                    this.currentAttack = { name: 'High Jab', zone: 'HEAD', startup: 6 + startupPen, active: 4, recovery: 10, dmg: 10, kbX: 90 };
                } else if (type === 'HEAD_KICK') {
                    this.currentAttack = { name: 'Roundhouse', zone: 'HEAD', startup: 11 + startupPen, active: 5, recovery: 16, dmg: 22, kbX: 210 };
                } else if (type === 'TORSO_PUNCH') {
                    this.currentAttack = { name: 'Gut Punch', zone: 'TORSO', startup: 8 + startupPen, active: 5, recovery: 12, dmg: 15, kbX: 130 };
                } else if (type === 'LOW_SWEEP') {
                    this.currentAttack = { name: 'Low Sweep', zone: 'LEFT_LIMBS', startup: 9 + startupPen, active: 5, recovery: 17, dmg: 14, kbX: 160 };
                } else if (type === 'ARM_CRUSHER') {
                    this.currentAttack = { name: 'Arm Crusher', zone: 'RIGHT_LIMBS', startup: 12 + startupPen, active: 5, recovery: 18, dmg: 20, kbX: 150 };
                } else if (type === 'SUPER') {
                    this.currentAttack = { name: 'SUPER BURST', zone: 'HEAD', startup: 15, active: 8, recovery: 28, dmg: 38, kbX: 300 };
                }
            }

            update(opponent) {
                if (this.hitStop > 0) { this.hitStop--; return; }

                const status = this.getStatus();
                if (this.state !== 'ATTACK' && this.state !== 'HITSTUN') {
                    this.facing = opponent.x >= this.x ? 1 : -1;
                }

                if (this.state === 'ATTACK') {
                    this.actionFrame++;
                    const a = this.currentAttack;
                    const dynamicRecovery = Math.round(a.recovery * status.returnToBaseMultiplier);

                    if (this.actionFrame > a.startup && this.actionFrame <= a.startup + a.active) {
                        let hbY = this.y + 20;
                        if (a.zone === 'HEAD') hbY = this.y - 4;
                        if (a.zone === 'LEFT_LIMBS') hbY = this.y + 55;
                        this.activeHitbox = {
                            x: this.facing === 1 ? this.x + this.width : this.x - 58,
                            y: hbY, width: 58, height: 46, attack: a
                        };
                    } else {
                        this.activeHitbox = null;
                    }

                    if (this.actionFrame >= a.startup + a.active + dynamicRecovery) {
                        this.state = 'IDLE';
                        this.currentAttack = null;
                        this.activeHitbox = null;
                    }
                } else if (this.state === 'HITSTUN') {
                    this.actionFrame++;
                    this.vx *= 0.85;
                    if (this.actionFrame > 24) { this.state = 'IDLE'; }
                }

                this.vy += 1200 * this.mass * FIXED_DT;
                this.x += this.vx * FIXED_DT;
                this.y += this.vy * FIXED_DT;

                const floorY = 445;
                if (this.y + this.height >= floorY) {
                    this.y = floorY - this.height;
                    this.vy = 0;
                    this.isGrounded = true;
                }
                this.x = Math.max(25, Math.min(canvas.width - 75, this.x));
            }
        }

        const p1 = new Fighter('KAGE-09', 240, 1, 0.85, '#06b6d4');
        const cpu = new Fighter('GOLIATH-V', 680, -1, 1.35, '#ef4444');

        function checkOverlap(r1, r2) {
            return r1.x < r2.x + r2.width && r1.x + r1.width > r2.x &&
                   r1.y < r2.y + r2.height && r1.y + r1.height > r2.y;
        }

        function resolveCombat(atk, def) {
            if (!atk.activeHitbox || def.state === 'HITSTUN') return;
            const hb = atk.activeHitbox;
            const hurtboxes = def.getHurtboxes();

            let hitZone = null;
            if (checkOverlap(hb, hurtboxes[hb.attack.zone])) {
                hitZone = hb.attack.zone;
            } else {
                for (let z of ['HEAD', 'TORSO', 'LEFT_LIMBS', 'RIGHT_LIMBS']) {
                    if (checkOverlap(hb, hurtboxes[z])) { hitZone = z; break; }
                }
            }

            if (hitZone) {
                const isCounter = def.state === 'ATTACK';
                if (def.state === 'BLOCK') {
                    def.hp = Math.max(0, def.hp - Math.floor(hb.attack.dmg * 0.15));
                    def.vx = atk.facing * 70;
                    RetroAudio.playBlock();
                    camera.hitZoom += 0.04;
                } else {
                    const status = def.getStatus();
                    let dmg = hb.attack.dmg;
                    if (isCounter) dmg = Math.floor(dmg * 1.35);
                    if (status.torsoBreached) dmg = Math.floor(dmg * 1.25);

                    def.hp = Math.max(0, def.hp - dmg);
                    def.zones[hitZone].hp = Math.max(0, def.zones[hitZone].hp - Math.floor(dmg * 1.5));
                    if (def.zones[hitZone].hp === 0) def.zones[hitZone].isBroken = true;

                    def.vx = atk.facing * (hb.attack.kbX / def.mass);
                    def.state = 'HITSTUN';
                    def.actionFrame = 0;
                    atk.hitStop = 4;
                    def.hitStop = 4;

                    camera.hitZoom += (isCounter ? 0.18 : 0.10);
                    RetroAudio.playHit(def.zones[hitZone].isBroken ? 'crack' : 'heavy');
                }
                atk.activeHitbox = null;
                updateHUD();
            }
        }

        function updateHUD() {
            document.getElementById('p1HpText').textContent = p1.hp + '%';
            document.getElementById('cpuHpText').textContent = cpu.hp + '%';
            document.getElementById('p1Head').textContent = 'H:' + p1.zones.HEAD.hp + '%';
            document.getElementById('p1Torso').textContent = 'T:' + p1.zones.TORSO.hp + '%';
            document.getElementById('p1LLimb').textContent = 'L:' + p1.zones.LEFT_LIMBS.hp + '%';
            document.getElementById('p1RLimb').textContent = 'R:' + p1.zones.RIGHT_LIMBS.hp + '%';

            document.getElementById('cpuHead').textContent = 'H:' + cpu.zones.HEAD.hp + '%';
            document.getElementById('cpuTorso').textContent = 'T:' + cpu.zones.TORSO.hp + '%';
            document.getElementById('cpuLLimb').textContent = 'L:' + cpu.zones.LEFT_LIMBS.hp + '%';
            document.getElementById('cpuRLimb').textContent = 'R:' + cpu.zones.RIGHT_LIMBS.hp + '%';
        }

        // MULTITOUCH ANALOG THUMBSTICK LOGIC
        const stickContainer = document.getElementById('touchStickContainer');
        const stickKnob = document.getElementById('stickKnob');
        let stickActiveId = null;

        stickContainer.addEventListener('pointerdown', e => {
            if (stickActiveId !== null) return;
            stickActiveId = e.pointerId;
            stickContainer.setPointerCapture(e.pointerId);
            updateStick(e);
        });
        stickContainer.addEventListener('pointermove', e => {
            if (e.pointerId === stickActiveId) updateStick(e);
        });
        const releaseStick = e => {
            if (e.pointerId === stickActiveId) {
                stickActiveId = null;
                stickKnob.style.transform = 'translate3d(0, 0, 0)';
                p1.vx = 0;
                if (p1.state === 'CROUCH') p1.state = 'IDLE';
            }
        };
        stickContainer.addEventListener('pointerup', releaseStick);
        stickContainer.addEventListener('pointercancel', releaseStick);

        function updateStick(e) {
            initAudio();
            const rect = stickContainer.getBoundingClientRect();
            const cx = rect.left + rect.width / 2;
            const cy = rect.top + rect.height / 2;
            let dx = e.clientX - cx;
            let dy = e.clientY - cy;
            const dist = Math.hypot(dx, dy);
            const maxR = 36;
            if (dist > maxR) {
                dx = (dx / dist) * maxR;
                dy = (dy / dist) * maxR;
            }
            stickKnob.style.transform = 'translate3d(' + dx + 'px, ' + dy + 'px, 0)';

            const status = p1.getStatus();
            const speed = 220 * status.baseSpeedMultiplier;

            if (dx < -12) p1.vx = -speed;
            else if (dx > 12) p1.vx = speed;
            else p1.vx = 0;

            if (dy < -18 && p1.isGrounded) { p1.vy = -500; p1.isGrounded = false; }
            if (dy > 18) p1.state = 'CROUCH';
            else if (p1.state === 'CROUCH') p1.state = 'IDLE';
        }

        // BUTTON MULTITOUCH LISTENERS
        function bindBtn(id, fn) {
            const btn = document.getElementById(id);
            btn.addEventListener('pointerdown', e => {
                e.preventDefault();
                initAudio();
                btn.classList.add('active');
                fn();
            });
            btn.addEventListener('pointerup', () => btn.classList.remove('active'));
            btn.addEventListener('pointercancel', () => btn.classList.remove('active'));
        }

        bindBtn('btnX', () => p1.attack('HEAD_KICK'));
        bindBtn('btnY', () => p1.attack('HEAD_JAB'));
        bindBtn('btnA', () => p1.attack('ARM_CRUSHER'));
        bindBtn('btnB', () => p1.attack('LOW_SWEEP'));
        bindBtn('btnMid', () => p1.attack('TORSO_PUNCH'));
        bindBtn('btnSuper', () => p1.attack('SUPER'));

        const guardBtn = document.getElementById('btnGuard');
        guardBtn.addEventListener('pointerdown', e => { e.preventDefault(); initAudio(); p1.state = 'BLOCK'; guardBtn.classList.add('active'); });
        const releaseGuard = () => { if (p1.state === 'BLOCK') p1.state = 'IDLE'; guardBtn.classList.remove('active'); };
        guardBtn.addEventListener('pointerup', releaseGuard);
        guardBtn.addEventListener('pointercancel', releaseGuard);

        // KEYBOARD
        window.addEventListener('keydown', e => {
            initAudio();
            const speed = 220 * p1.getStatus().baseSpeedMultiplier;
            if (e.code === 'KeyA') p1.vx = -speed;
            if (e.code === 'KeyD') p1.vx = speed;
            if (e.code === 'KeyW' && p1.isGrounded) { p1.vy = -500; p1.isGrounded = false; }
            if (e.code === 'KeyS') p1.state = 'CROUCH';
            if (e.code === 'KeyL') p1.state = 'BLOCK';
            if (e.code === 'KeyU') p1.attack('HEAD_JAB');
            if (e.code === 'KeyI') p1.attack('ARM_CRUSHER');
            if (e.code === 'KeyJ') p1.attack('TORSO_PUNCH');
            if (e.code === 'KeyK') p1.attack('LOW_SWEEP');
            if (e.code === 'Space') p1.attack('SUPER');
        });
        window.addEventListener('keyup', e => {
            if (e.code === 'KeyA' || e.code === 'KeyD') p1.vx = 0;
            if (e.code === 'KeyS' || e.code === 'KeyL') p1.state = 'IDLE';
        });

        // AUTO BATTLE AI
        let tick = 0;
        function updateAI() {
            if (!autoBattle) return;
            const dist = cpu.x - p1.x;
            const p1Speed = 190 * p1.getStatus().baseSpeedMultiplier;
            const cpuSpeed = 160 * cpu.getStatus().baseSpeedMultiplier;

            if (Math.abs(dist) > 140) {
                p1.vx = dist > 0 ? p1Speed : -p1Speed;
            } else {
                p1.vx = 0;
                if (tick % 35 === 0 && p1.state === 'IDLE') {
                    p1.attack(['HEAD_JAB', 'HEAD_KICK', 'TORSO_PUNCH', 'LOW_SWEEP'][Math.floor(Math.random() * 4)]);
                }
            }

            if (Math.abs(dist) > 130) {
                cpu.vx = dist > 0 ? -cpuSpeed : cpuSpeed;
            } else {
                cpu.vx = 0;
                if (tick % 40 === 0 && cpu.state === 'IDLE') {
                    cpu.attack(['HEAD_JAB', 'TORSO_PUNCH', 'LOW_SWEEP', 'ARM_CRUSHER'][Math.floor(Math.random() * 4)]);
                }
            }
        }

        // MAIN GAME & RENDER LOOP
        function loop() {
            tick++;
            updateAI();
            p1.update(cpu);
            cpu.update(p1);
            resolveCombat(p1, cpu);
            resolveCombat(cpu, p1);

            // Natural Camera Zoom interpolation without jerking
            const midX = (p1.x + cpu.x) / 2 + 26;
            const midY = (p1.y + cpu.y) / 2 + 10;
            const dist = Math.abs(p1.x - cpu.x);
            const distRatio = Math.max(0, Math.min(1, 1 - (dist - 60) / 280));
            const targetZoom = Math.min(1.75, 1.20 + distRatio * 0.25 + camera.hitZoom);

            camera.x += (midX - camera.x) * 0.08;
            camera.y += (midY - camera.y) * 0.08;
            camera.zoom += (targetZoom - camera.zoom) * 0.06;
            camera.hitZoom *= 0.92;

            if (p1.hp <= 0 || cpu.hp <= 0) {
                p1.hp = 100; cpu.hp = 100;
                for (let k in p1.zones) p1.zones[k].hp = 100;
                for (let k in cpu.zones) cpu.zones[k].hp = 100;
                p1.x = 240; cpu.x = 680;
                updateHUD();
            }

            // Render
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Cyber Skyline Background
            ctx.fillStyle = "#0c0a18"; ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = "#161329";
            ctx.fillRect(80, 160, 90, 290);
            ctx.fillRect(220, 120, 110, 330);
            ctx.fillRect(630, 140, 100, 310);
            ctx.fillRect(780, 100, 120, 350);

            // Camera Transformation
            ctx.save();
            ctx.translate(canvas.width / 2, canvas.height * 0.62);
            ctx.scale(camera.zoom, camera.zoom);
            ctx.translate(-camera.x, -camera.y);

            // Arena Floor
            ctx.fillStyle = "#18142b"; ctx.fillRect(-200, 445, canvas.width + 400, 160);
            ctx.strokeStyle = "#6366f1"; ctx.lineWidth = 2;
            ctx.beginPath(); ctx.moveTo(-200, 445); ctx.lineTo(canvas.width + 200, 445); ctx.stroke();

            // Fighters
            drawFighter(p1);
            drawFighter(cpu);

            ctx.restore();

            requestAnimationFrame(loop);
        }

        function drawFighter(f) {
            ctx.save();
            ctx.translate(f.x, f.y);
            ctx.fillStyle = f.state === 'HITSTUN' ? '#f43f5e' : (f.state === 'ATTACK' ? '#fb923c' : f.color);
            ctx.fillRect(0, 20, f.width, f.height - 20);
            ctx.fillStyle = '#fde047';
            ctx.fillRect(f.facing === 1 ? 26 : 6, 4, 20, 14);

            if (showColliders) {
                ctx.strokeStyle = '#22c55e';
                ctx.strokeRect(0, 0, f.width, f.height);
                if (f.activeHitbox) {
                    ctx.fillStyle = 'rgba(239, 68, 68, 0.4)';
                    ctx.fillRect(f.activeHitbox.x - f.x, f.activeHitbox.y - f.y, f.activeHitbox.width, f.activeHitbox.height);
                }
            }
            ctx.restore();
        }

        requestAnimationFrame(loop);
    </script>
</body>
