      "code": "const M08_Watchdog = {\n  snapshots: [],\n  recordHeal(reason) {\n    M01_Config.telemetry.healsPerformed += 1;\n    M01_Config.telemetry.lastHealReason = reason;\n    M01_Config.telemetry.healLog.push({ tick: M01_Config.telemetry.tickCount, reason });\n    if (M01_Config.telemetry.healLog.length > 25) M01_Config.telemetry.healLog.shift();\n  },\n  enforceCabinetDipRules() {\n    const dip = M01_Config.cabinetDip, inf = M01_Config.infusion;\n    if (dip.difficulty < 1 || dip.difficulty > 5) { dip.difficulty = 3; if (M01_Config.telemetry.selfHealEnabled) this.recordHeal(\"Normalized DIP difficulty\"); }\n    if (dip.slamTilt) { dip.slamTilt = false; M01_Config.telemetry.hitstopFrames = 0; if (M01_Config.telemetry.selfHealEnabled) this.recordHeal(\"Cleared cabinet SLAM TILT\"); }\n    if (!Number.isFinite(inf.meshSpringStiffness) || inf.meshSpringStiffness < 20 || inf.meshSpringStiffness > 1200) {\n      inf.meshSpringStiffness = 265; inf.springPreset = \"CUSTOM\";\n      if (M01_Config.telemetry.selfHealEnabled) this.recordHeal(\"Reset spring stiffness k\");\n    }\n    if (!Number.isFinite(inf.meshSpringDamping) || inf.meshSpringDamping < 0 || inf.meshSpringDamping > 120) {\n      inf.meshSpringDamping = 22; inf.springPreset = \"CUSTOM\";\n      if (M01_Config.telemetry.selfHealEnabled) this.recordHeal(\"Reset spring damping d\");\n    }\n  },\n  captureSnapshot(state) {\n    if (M01_Config.telemetry.tickCount % M01_Config.snapshotIntervalTicks !== 0) return;\n    const snapFighter = (f) => ({ x: f.x, y: f.y, vx: f.vx, vy: f.vy, facing: f.facing, grounded: f.grounded, hp: f.hp, state: f.state });\n    this.snapshots.push({ p1: snapFighter(state.p1), p2: snapFighter(state.p2) });\n    if (this.snapshots.length > M01_Config.maxSnapshots) this.snapshots.shift();\n  },\n  restoreSnapshot(state) {\n    if (!M01_Config.telemetry.selfHealEnabled) return;\n    const snap = this.snapshots[this.snapshots.length - 1]; if (!snap) return;\n    for (const slot of [\"p1\", \"p2\"]) {\n      const f = state[slot], s = snap[slot];\n      if (!Number.isFinite(f.x) || !Number.isFinite(f.y) || !Number.isFinite(f.hp)) Object.assign(f, s, { animTimer: 0, meshDyn: null });\n    }\n  },\n  sanitizeFighter(f, fallbackX, fallbackFacing) {\n    if (!M01_Config.telemetry.selfHealEnabled) return;\n    let healed = false;\n    if (!M02_SpriteMeshAtlas.fighters.has(f.fighterId)) { f.fighterId = \"SCORPION_MK_REMIX\"; healed = true; }\n    if (!Number.isFinite(f.x) || f.x < M01_Config.arenaLeft || f.x > M01_Config.arenaRight) { f.x = fallbackX; healed = true; }\n    if (!Number.isFinite(f.y) || f.y > M01_Config.floorY || f.y < -260) { f.y = M01_Config.floorY; f.vy = 0; f.grounded = true; healed = true; }\n    if (!Number.isFinite(f.vx) || Math.abs(f.vx) > 2500) { f.vx = 0; healed = true; }\n    if (!Number.isFinite(f.vy) || Math.abs(f.vy) > 3500) { f.vy = 0; healed = true; }\n    if (!Number.isFinite(f.hp) || f.hp < 0 || f.hp > 100) { f.hp = 100; healed = true; }\n    if (!Number.isFinite(f.squashY) || f.squashY < 0.5 || f.squashY > 1.5) { f.squashY = 1; healed = true; }\n    if (!Number.isFinite(f.animTimer) || f.animTimer < 0) { f.animTimer = 0; healed = true; }\n    if (f.facing !== 1 && f.facing !== -1) { f.facing = fallbackFacing; healed = true; }\n    if (!Object.keys(mkAnims).includes(f.state)) { f.state = \"idle\"; f.animTimer = 0; healed = true; }\n    if (f.state !== \"ko\" && f.state === f.prevState) {\n      f.stateFrames = (f.stateFrames || 0) + 1;\n      if (f.stateFrames > M01_Config.maxStateFrames) { f.state = \"idle\"; f.animTimer = 0; f.stateFrames = 0; healed = true; }\n    } else { f.prevState = f.state; f.stateFrames = 0; }\n    if (healed) this.recordHeal(`Healed ${f.slot}`);\n  },\n  exportStudioPayload(state) {\n    return JSON.stringify({ meta: { engine: \"MK-2D-SpriteMesh-Autonomous\", codePart: CODE_PART, buildDate: BUILD_DATE, exportedAt: new Date().toISOString(), moduleCount: 10 }, manualSpec: M01_ArcadeManualSpec,