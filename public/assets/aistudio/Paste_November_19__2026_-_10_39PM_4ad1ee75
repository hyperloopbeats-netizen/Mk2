      "code": "const M07_AudioFx = {\n  ctx: null,\n  tone(freqStart, freqEnd, type, dur, vol) {\n    try {\n      const AudioCtx = window.AudioContext || window.webkitAudioContext;\n      if (!AudioCtx) return;\n      if (!this.ctx) this.ctx = new AudioCtx();\n      if (this.ctx.state === \"suspended\") this.ctx.resume();\n      const osc = this.ctx.createOscillator(), gain = this.ctx.createGain();\n      osc.type = type;\n      osc.frequency.setValueAtTime(freqStart, this.ctx.currentTime);\n      osc.frequency.exponentialRampToValueAtTime(Math.max(20, freqEnd), this.ctx.currentTime + dur);\n      gain.gain.setValueAtTime(vol, this.ctx.currentTime);\n      gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + dur);\n      osc.connect(gain); gain.connect(this.ctx.destination); osc.start(); osc.stop(this.ctx.currentTime + dur);\n    } catch (_) {}\n  },\n  playHit(heavy) { this.tone(heavy ? 155 : 225, 42, heavy ? \"sawtooth\" : \"triangle\", 0.12, 0.11); },\n  playBlock() { this.tone(520, 310, \"square\", 0.07, 0.06); },\n  playFinisher() { this.tone(110, 36, \"sawtooth\", 0.35, 0.15); }\n};"
