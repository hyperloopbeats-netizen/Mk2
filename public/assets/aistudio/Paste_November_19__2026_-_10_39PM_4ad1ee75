      "role": "Keyboard polling, directional motion history, quarter-circle projectile detection, and manual command resolution.",
      "code": "const M03_InputBus = {\n  keysDown: new Set(), queues: { p1: [], p2: [] }, history: { p1: [], p2: [] },\n  init() {\n    window.addEventListener(\"keydown\", (e) => {\n      this.keysDown.add(e.code);\n      const b = M01_ArcadeManualSpec.buttons;\n      if (e.code === b.HP) this.pushCommand(\"p1\", \"HP\");\n      if (e.code === b.LP) this.pushCommand(\"p1\", \"LP\");\n      if (e.code === b.HK) this.pushCommand(\"p1\", \"HK\");\n      if (e.code === b.LK) this.pushCommand(\"p1\", \"LK\");\n      if (e.code === b.UP) this.pushCommand(\"p1\", \"UP\");\n      if (e.code === b.START) this.pushCommand(\"p1\", \"START\");\n    });\n    window.addEventListener(\"keyup\", (e) => { this.keysDown.delete(e.code); });\n  },\n  pollStick(slot, facing) {\n    if (slot !== \"p1\") return { moveX: 0, crouch: false, blocking: false };\n    const b = M01_ArcadeManualSpec.buttons;\n    let moveX = 0;\n    if (this.keysDown.has(b.LEFT)) moveX -= 1;\n    if (this.keysDown.has(b.RIGHT)) moveX += 1;\n    const crouch = this.keysDown.has(b.DOWN), blocking = this.keysDown.has(b.BL);\n    const rel = moveX === 0 ? 0 : (moveX * facing > 0 ? 1 : -1);\n    const dirTag = crouch ? (rel > 0 ? \"DF\" : rel < 0 ? \"DB\" : \"D\") : (rel > 0 ? \"F\" : rel < 0 ? \"B\" : \"N\");\n    const hist = this.history[slot], last = hist[hist.length - 1];\n    if (!last || last.dir !== dirTag) { hist.push({ dir: dirTag, age: 0 }); if (hist.length > 10) hist.shift(); }\n    return { moveX, crouch, blocking };\n  },\n  hasQuarterCircleForward(slot) {\n    const dirs = (this.history[slot] || []).map((h) => h.dir), seq = [\"D\", \"DF\", \"F\"];\n    let ptr = 0;\n    for (const d of dirs) { if (d === seq[ptr] && ++ptr === seq.length) return true; }\n    return false;\n  },\n  resolveManualMove(f, opp, rawBtn, stick) {\n    if (rawBtn === \"START\") return null;\n    if (rawBtn === \"UP\") return \"jump\";\n    const isClose = Math.abs(opp.x - f.x) < 76 && Math.abs(f.y - opp.y) < 55;\n    const relDir = stick.moveX === 0 ? 0 : (stick.moveX * f.facing > 0 ? 1 : -1);\n    if (M01_Config.infusion.activeFinisherWindow && rawBtn === \"HP\") {\n      if ((this.history[f.slot] || []).filter((h) => h.dir === \"F\").length >= 2 || isClose) return \"FINISHER_STAGE_INFUSE\";\n    }\n    if (rawBtn === \"LP\" && this.hasQuarterCircleForward(f.slot)) { this.history[f.slot] = []; return \"projectile\"; }\n    if (stick.crouch) return rawBtn === \"HP\" || rawBtn === \"LP\" ? \"uppercut\" : (rawBtn === \"LK\" ? \"sweep\" : \"lk\");\n    if (relDir < 0 && f.grounded) return rawBtn === \"LK\" ? \"sweep\" : (rawBtn === \"HK\" ? \"roundhouse\" : rawBtn.toLowerCase());\n    if (isClose && f.grounded) return rawBtn === \"LP\" ? \"throw\" : (rawBtn === \"HP\" ? \"hp\" : \"lk\");\n    if (!f.grounded) return [\"HP\", \"LP\"].includes(rawBtn) ? \"hp\" : \"hk\";\n    return rawBtn.toLowerCase();\n  },\n  pushCommand(slot, cmd) { const q = this.queues[slot]; if (q && q.length < 8) q.push({ cmd, ttl: 10 }); },\n  consumeCommand(slot) { const q = this.queues[slot]; while (q && q.length > 0) { const i = q.shift(); if (i && i.ttl > 0) return i.cmd; } return null; },\n  tickQueues() {\n    for (const q of Object.values(this.queues)) for (let i = q.length - 1; i >= 0; i--) if (--q[i].ttl <= 0) q.splice(i, 1);\n    for (const h of Object.values(this.history)) for (let i = h.length - 1; i >= 0; i--) if (++h[i].age > 24) h.splice(i, 1);\n  }\n};"
