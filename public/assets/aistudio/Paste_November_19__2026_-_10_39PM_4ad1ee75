      "code": "const M05_CombatResolver = {\n  isBlocking(defender, attackerFacing, attackSpec) {\n    if (!defender.grounded || (attackSpec && attackSpec.unblockableClose)) return false;\n    if ([\"hp\", \"lp\", \"hk\", \"lk\", \"uppercut\", \"sweep\", \"roundhouse\", \"throw\", \"projectile\", \"hitstun\", \"blockstun\", \"ko\"].includes(defender.state)) return false;\n    return Boolean(defender.blocking) || defender.moveDir === -attackerFacing;\n  },\n  applyImpact(attacker, defender, spec, hitX, hitY) {\n    if (this.isBlocking(defender, attacker.facing, spec)) {\n      defender.hp = Math.max(1, defender.hp - spec.chipDamage);\n      defender.vx = attacker.facing * (spec.knockbackX * 0.65);\n      defender.state = \"blockstun\"; defender.animTimer = 0; defender.invulnTimer = 0.1;\n      if (attacker.combo !== undefined) attacker.combo = 0;\n      attacker.score = (attacker.score || 0) + 250;\n      M01_Config.telemetry.hitstopFrames = 3; M04_MeshPhysics.addShake(3);\n      M07_AudioFx.playBlock(); M10_Renderer.spawnSpark(hitX, hitY, \"#94a3b8\"); return;\n    }\n    attacker.combo = (attacker.combo || 0) + 1;\n    const finalDamage = Math.max(2, Math.round(spec.damage * Math.max(0.55, 1 - (attacker.combo - 1) * 0.1)));\n    attacker.score = (attacker.score || 0) + finalDamage * 100 * attacker.combo;\n    defender.hp = Math.max(0, defender.hp - finalDamage);\n    defender.vx = attacker.facing * spec.knockbackX;\n    defender.squashY = spec.knockdown ? 0.7 : 0.78;\n    defender.invulnTimer = 0.16;\n    if (defender.meshDyn) for (const dyn of Object.values(defender.meshDyn)) {\n      dyn.vx += attacker.facing * (spec.knockbackX * 0.85);\n      dyn.vy += (spec.launchY < 0 ? spec.launchY * 0.5 : -120);\n    }\n    M01_Config.telemetry.hitstopFrames = spec.damage >= 15 ? 6 : 4;\n    M04_MeshPhysics.addShake(spec.damage >= 15 ? 8 : 4);\n    if (spec.launchY < 0 && defender.hp > 0) { defender.vy = spec.launchY; defender.grounded = false; }\n    if (defender.hp <= 0) {