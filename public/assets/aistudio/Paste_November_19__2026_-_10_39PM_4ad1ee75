      "role": "Spring-damper 2D mesh integration using meshSpringStiffness and meshSpringDamping, bone relaxation, arena bounds, projectiles, and stage finishers.",
      "code": "const M04_MeshPhysics = {\n  projectiles: [],\n  addShake(amount) { M01_Config.infusion.shakeIntensity = Math.min(18, Math.max(M01_Config.infusion.shakeIntensity, amount)); },\n  ensureMeshDynamics(f) {\n    if (!f.meshDyn) f.meshDyn = {};\n    if (!f.activeFrame || !f.activeFrame.nodes) return;\n    for (const [name, target] of Object.entries(f.activeFrame.nodes)) {\n      if (!f.meshDyn[name]) f.meshDyn[name] = { wx: f.x + target.x * f.facing, wy: f.y + target.y, vx: 0, vy: 0 };\n    }\n  },\n  integrateKinematics(f, opp, subDt) {\n    const busy = [\"hp\", \"lp\", \"hk\", \"lk\", \"uppercut\", \"sweep\", \"roundhouse\", \"throw\", \"projectile\", \"hitstun\", \"blockstun\", \"ko\"].includes(f.state);\n    if (f.grounded && !busy) f.facing = opp.x >= f.x ? 1 : -1;\n    if (f.state === \"walk\") f.vx = f.moveDir * 255;\n    else if (f.grounded && ![\"hitstun\", \"blockstun\"].includes(f.state)) f.vx *= Math.pow(0.001, subDt);\n    if (!f.grounded || f.vy < 0) f.vy += M01_Config.gravity * subDt;\n    f.x += f.vx * subDt; f.y += f.vy * subDt;\n    if (f.y >= M01_Config.floorY) { f.y = M01_Config.floorY; f.vy = 0; f.grounded = true; if (f.state === \"jump\") f.state = \"idle\"; }\n    const infLevel = M01_Config.infusion.stageInfusionLevel;\n    const stage = STAGE_PRESETS[M01_Config.infusion.stageIndex] || STAGE_PRESETS[0];\n    const hazardWave = infLevel > 0 ? Math.sin(M01_Config.infusion.hazardPulsePhase) * stage.hazardAmp * (infLevel / 100) : 0;\n    this.ensureMeshDynamics(f);\n    const stiffness = M01_Config.infusion.meshSpringStiffness, damping = M01_Config.infusion.meshSpringDamping;\n    if (f.activeFrame && f.activeFrame.nodes) {\n      for (const [name, node] of Object.entries(f.activeFrame.nodes)) {\n        const dyn = f.meshDyn[name];\n        const tx = f.x + node.x * f.facing, ty = f.y + node.y + (name === \"head\" || name === \"torso\" ? hazardWave * 6 : 0);\n        dyn.vx += ((tx - dyn.wx) * stiffness - dyn.vx * damping) * subDt;\n        dyn.vy += ((ty - dyn.wy) * stiffness - dyn.vy * damping) * subDt;\n        dyn.wx += dyn.vx * subDt; dyn.wy += dyn.vy * subDt;\n      }\n    }\n  },\n  solveConstraints(f, opp) {\n    f.x = Math.max(M01_Config.arenaLeft, Math.min(M01_Config.arenaRight, f.x));\n    const dx = opp.x - f.x, dist = Math.abs(dx);\n    if (dist < 44 && Math.abs(f.y - opp.y) < 70) {\n      f.x = Math.max(M01_Config.arenaLeft, Math.min(M01_Config.arenaRight, f.x + (dx >= 0 ? -1 : 1) * (44 - dist) * 0.5));\n    }\n    if (f.meshDyn && f.meshDyn.pelvis && f.meshDyn.torso && f.meshDyn.head) {\n      const relax = (a, b, targetLen) => {\n        const lx = b.wx - a.wx, ly = b.wy - a.wy, len = Math.hypot(lx, ly) || 1, diff = ((len - targetLen) / len) * 0.35;\n        a.wx += lx * diff; a.wy += ly * diff; b.wx -= lx * diff; b.wy -= ly * diff;\n      };\n      relax(f.meshDyn.pelvis, f.meshDyn.torso, 40); relax(f.meshDyn.torso, f.meshDyn.head, 36);\n    }\n    f.worldMesh = {};\n    if (f.activeFrame && f.activeFrame.nodes) {\n      for (const [name, node] of Object.entries(f.activeFrame.nodes)) {\n        const dyn = f.meshDyn[name] || { wx: f.x + node.x * f.facing, wy: f.y + node.y };\n        dyn.wx = Math.max(M01_Config.arenaLeft - 24, Math.min(M01_Config.arenaRight + 24, dyn.wx));\n        dyn.wy = Math.min(M01_Config.floorY + 6, dyn.wy);\n        f.worldMesh[name] = { wx: dyn.wx, wy: dyn.wy, r: node.r, type: node.type };\n      }\n    }\n  },\n  advanceAnimation(f, dt) {\n    f.squashY += (1 - f.squashY) * Math.min(1, dt * 16);\n    f.animTimer += dt * 12;\n    const frameData = M02_SpriteMeshAtlas.getFrameData(f.fighterId, f.state, f.animTimer, f.squashY);\n    if (!frameData.loop && Math.floor(f.animTimer) >= frameData.totalFrames) {\n      if (f.state === \"ko\") f.animTimer = frameData.totalFrames - 1;\n      else { f.state = f.grounded ? \"idle\" : \"jump\"; f.animTimer = 0; }\n    }\n    f.activeFrame = M02_SpriteMeshAtlas.getFrameData(f.fighterId, f.state, f.animTimer, f.squash