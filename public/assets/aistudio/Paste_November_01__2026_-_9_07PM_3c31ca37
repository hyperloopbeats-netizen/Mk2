    <script>
        class SoundEngine {
            constructor() { this.ctx = null; }
            init() {
                if (!this.ctx) this.ctx = new (window.AudioContext || window.webkitAudioContext)();
                if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume().catch(() => {});
            }
            playHit(freq = 130, type = 'sawtooth', duration = 0.16) {
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(32, this.ctx.currentTime + duration);
                gain.gain.setValueAtTime(0.5, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + duration);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + duration);
            }
            playSubBass(freq = 42, duration = 0.8) {
                if (!this.ctx) return;
                const t = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(freq, t);
                osc.frequency.exponentialRampToValueAtTime(20, t + duration);
                gain.gain.setValueAtTime(0.7, t);
                gain.gain.exponentialRampToValueAtTime(0.001, t + duration);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(t);
                osc.stop(t + duration);
            }
        }
        const audio = new SoundEngine();

        /* KINETIC WEAPON MATRIX (KWM) */
        class ProceduralWeapon {
            constructor(weaponClass, primaryColor) {
                this.weaponClass = weaponClass; // 'CHAIN', 'BLADE', 'STAFF', 'CRYOMANCER'
                this.color = primaryColor;
                this.animPhase = Math.random() * 10;
            }

            render(ctx, x, y, facing, state, stateTimer) {
                ctx.save();
                ctx.translate(x, y);
                if (facing === -1) ctx.scale(-1, 1);
                this.animPhase += 0.2;

                switch (this.weaponClass) {
                    case 'CHAIN':
                        if (state === 'SPEAR' || state === 'WPN') {
                            const reach = Math.sin(stateTimer * 0.25) * 160 + 160;
                            ctx.strokeStyle = '#e4e4e7';
                            ctx.lineWidth = 3;
                            ctx.beginPath();
                            ctx.moveTo(0, -30);
                            for (let i = 0; i < reach; i += 12) {
                                ctx.lineTo(i, -30 + Math.sin(i * 0.05 + this.animPhase * 2) * 8);
                            }
                            ctx.stroke();
                            ctx.fillStyle = '#ef4444';
                            ctx.beginPath();
                            ctx.moveTo(reach, -38);
                            ctx.lineTo(reach + 22, -30);
                            ctx.lineTo(reach, -22);
                            ctx.fill();
                        }
                        break;

                    case 'BLADE':
                        ctx.save();
                        ctx.translate(15, -35);
                        const swing = (state === 'ATTACK' || state === 'WPN') ? Math.sin(stateTimer * 0.6) * 1.8 : 0.25;
                        ctx.rotate(swing);
                        ctx.fillStyle = '#27272a';
                        ctx.fillRect(-6, -4, 12, 8);
                        ctx.fillStyle = this.color;
                        ctx.shadowColor = this.color;
                        ctx.shadowBlur = 18;
                        ctx.beginPath();
                        ctx.moveTo(6, -2);
                        ctx.lineTo(85, -10);
                        ctx.lineTo(90, 2);
                        ctx.lineTo(6, 6);
                        ctx.fill();
                        ctx.restore();
                        break;

                    case 'STAFF':
                        ctx.save();
                        ctx.translate(0, -25);
                        ctx.rotate(Math.sin(this.animPhase * 0.5) * 0.45);
                        ctx.fillStyle = '#78350f';
                        ctx.fillRect(-4, -65, 8, 130);
                        ctx.fillStyle = this.color;
                        ctx.shadowColor = this.color;
                        ctx.shadowBlur = 12;
                        ctx.fillRect(-5, -70, 10, 10);
                        ctx.fillRect(-5, 60, 10, 10);
                        ctx.restore();
                        break;

                    case 'CRYOMANCER':
                        ctx.save();
                        ctx.translate(20, -40);
                        ctx.fillStyle = '#bae6fd';
                        ctx.shadowColor = '#0284c7';
                        ctx.shadowBlur = 15;
                        ctx.beginPath();
                        ctx.moveTo(0, 0);
                        ctx.lineTo(40, -18);
                        ctx.lineTo(50, 0);
                        ctx.lineTo(40, 18);
                        ctx.fill();
                        ctx.restore();
                        break;
                }
                ctx.restore();
            }
        }

