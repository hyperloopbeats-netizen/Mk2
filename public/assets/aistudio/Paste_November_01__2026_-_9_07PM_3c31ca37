        class Modular6MovementBox {
            constructor(owner) {
                this.owner = owner;
                this.levelY = 8;
                this.pose = {
                    head:  { rot: 0, ox: 0, oy: -75 },
                    torso: { rot: 0, ox: 0, oy: -45 },
                    lArm:  { rot: 15, ox: -12, oy: -55 },
                    rArm:  { rot: -20, ox: 12, oy: -55 },
                    lLeg:  { rot: 10, ox: -8, oy: -20 },
                    rLeg:  { rot: -10, ox: 8, oy: -20 }
                };
            }

            interpolatePose(targetLevel, targetPose, t) {
                const ease = t * t * (3 - 2 * t);
                const currentY = this.owner.yBase - (this.levelY * 7);
                const targetY  = this.owner.yBase - (targetLevel * 7);
                this.owner.y = currentY + (targetY - currentY) * ease;

                for (let part in this.pose) {
                    if (targetPose[part]) {
                        this.pose[part].rot += (targetPose[part].rot - this.pose[part].rot) * ease;
                        this.pose[part].ox  += (targetPose[part].ox  - this.pose[part].ox)  * ease;
                        this.pose[part].oy  += (targetPose[part].oy  - this.pose[part].oy)  * ease;
                    }
                }
            }

            render(ctx) {
                ctx.save();
                ctx.translate(this.owner.x, this.owner.y);
                if (this.owner.facing === -1) ctx.scale(-1, 1);
                const pc = this.owner.color;

                // Limbs & Torso
                ctx.fillStyle = '#52525b'; ctx.fillRect(this.pose.rArm.ox-4, this.pose.rArm.oy, 8, 26);
                ctx.fillStyle = '#27272a'; ctx.fillRect(this.pose.rLeg.ox-6, this.pose.rLeg.oy, 11, 34);
                ctx.fillStyle = '#18181b'; ctx.fillRect(this.pose.torso.ox-14, this.pose.torso.oy-15, 28, 35);
                ctx.fillStyle = pc; ctx.fillRect(this.pose.torso.ox-10, this.pose.torso.oy-15, 20, 35);
                
                // Head
                ctx.fillStyle = pc; ctx.beginPath(); ctx.arc(this.pose.head.ox, this.pose.head.oy-5, 12, 0, Math.PI * 2); ctx.fill();
                
                // Lead Limb & Weapon
                ctx.fillStyle = '#a1a1aa'; ctx.fillRect(this.pose.lArm.ox-4, this.pose.lArm.oy, 8, 26);
                
                // Render Self-Manufactured Weapon via KWM
                this.owner.weapon.render(ctx, 0, 0, 1, this.owner.state, this.owner.stateTimer);

                ctx.restore();
            }
        }

        class Character {
            constructor(rosterData, x, facing) {
                this.id = rosterData.id;
                this.name = rosterData.name;
                this.color = rosterData.color;
                this.x = x;
                this.yBase = 460;
                this.y = this.yBase;
                this.vx = 0;
                this.vy = 0;
                this.facing = facing;
                this.health = 250;
                this.maxHealth = 250;
                this.state = 'IDLE';
                this.stateTimer = 0;

                this.weapon = new ProceduralWeapon(rosterData.weapon, this.color);
                this.animBox = new Modular6MovementBox(this);
            }

            update(opponent) {
                this.stateTimer++;
                if (!['SPEAR', 'WPN', 'STAGGER'].includes(this.state)) {
                    this.facing = this.x < opponent.x ? 1 : -1;
                }
                this.x += this.vx;
                if (this.x < 80) this.x = 80;
                if (this.x > 1320) this.x = 1320;

                switch (this.state) {
                    case 'IDLE':
                        this.vx = 0;
                        this.animBox.interpolatePose(8 + Math.sin(this.stateTimer * 0.1) * 0.3, {}, 0.2);
                        break;
                    case 'WALK':
                        break;
                    case 'WPN':
                        this.vx = 0;
                        if (this.stateTimer > 35) this.state = 'IDLE';
                        break;
                    case 'STAGGER':
                        this.vx = -this.facing * 3;
                        if (this.stateTimer > 20) this.state = 'IDLE';
                        break;
                }
            }

            takeDamage(amount) {
                this.health = Math.max(0, this.health - amount);
                this.state = 'STAGGER';
                this.stateTimer = 0;
            }
        }

        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        canvas.width = 1400;
        canvas.height = 780;

        let gameState = 'CAMO_INTRO';
        let p1Cursor = 0;
        let p1 = new Character(ROSTER[0], 360, 1);
        let p2 = new Character(ROSTER[1], 1040, -1);

        const rosterGridEl = document.getElementById('roster-grid');
        ROSTER.forEach((char, index) => {
            const tile = document.createElement('div');
            tile.id = 'grid-tile-' + index;
            tile.className = 'glass-panel rounded-lg flex flex-col items-center justify-center p-1.5 cursor-pointer border-2 transition-all ' + (index === 0 ? 'border-orange-500 glass-panel-gold' : 'border-transparent');
            tile.innerHTML = `<span class="text-xl sm:text-2xl">${char.icon}</span><span class="text-[9px] font-bold text-zinc-300 mt-1">${char.name}</span>`;
            tile.onclick = () => selectCharacter(index);
            rosterGridEl.appendChild(tile);
        });

        function updateGridSelection() {
            ROSTER.forEach((_, idx) => {
                const el = document.getElementById('grid-tile-' + idx);
                if (el) el.className = idx === p1Cursor ? 'glass-panel glass-panel-gold rounded-lg flex flex-col items-center justify-center p-1.5 border-2 border-orange-500 scale-105 z-10' : 'glass-panel rounded-lg flex flex-col items-center justify-center p-1.5 border-2 border-transparent opacity-75';
            });
            const sel = ROSTER[p1Cursor];
            document.getElementById('p1-name').innerText = sel.name;
            document.getElementById('p1-title').innerText = sel.bio + ' // WPN: ' + sel.weapon;
            document.getElementById('p1-portrait-icon').innerText = sel.icon;
            p1 = new Character(sel, 360, 1);
        }

        function selectCharacter(index) {
            audio.init();
            p1Cursor = index;
            updateGridSelection();
            startMatchTransition();
        }

        function startMatchTransition() {
            gameState = 'VS_TRANSITION';
            audio.playHit(280, 'sawtooth', 0.4);
            audio.playSubBass(50, 1.0);
            setTimeout(() => {
                document.getElementById('character-select-menu').classList.add('hidden');
                document.getElementById('combat-hud').classList.remove('hidden');
                gameState = 'COMBAT';
            }, 1200);
        }

        document.getElementById('btn-start-game').onclick = () => {
            audio.init();
            audio.playSubBass(45, 1.2);
            document.getElementById('camo-intro-layer').classList.add('hidden');
            document.getElementById('ui-layer').classList.remove('hidden');
            gameState = 'MENU';
            updateGridSelection();
        };

        window.addEventListener('keydown', e => {
            if (gameState === 'MENU') {
                if (e.code === 'KeyD' || e.code === 'ArrowRight') { p1Cursor = (p1Cursor + 1) % ROSTER.length; updateGridSelection(); }
                if (e.code === 'KeyA' || e.code === 'ArrowLeft') { p1Cursor = (p1Cursor - 1 + ROSTER.length) % ROSTER.length; updateGridSelection(); }
                if (e.code === 'Enter' || e.code === 'Space') { startMatchTransition(); }
            } else if (gameState === 'COMBAT') {
                if (e.code === 'KeyWpn' || e.code === 'KeyF') { p1.state = 'WPN'; p1.stateTimer = 0; audio.playHit(300, 'sawtooth'); if(Math.abs(p1.x - p2.x) < 120) p2.takeDamage(28); }
            }
        });

        function gameLoop() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Layer 0: Deep Cyberpunk Sky Gradient
            const skyGrad = ctx.createLinearGradient(0, 0, 0, canvas.height);
            skyGrad.addColorStop(0, '#050714'); skyGrad.addColorStop(1, '#1b132e');
            ctx.fillStyle = skyGrad; ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Layer 1: Procedural Skyscraper Silhouette Skyline with Glowing Windows
            ctx.fillStyle = '#0b0c16';
            ctx.fillRect(100, 200, 140, 320);
            ctx.fillRect(280, 140, 180, 380);
            ctx.fillRect(500, 220, 120, 300);
            ctx.fillRect(850, 160, 200, 360);
            ctx.fillRect(1100, 240, 150, 280);

            ctx.fillStyle = 'rgba(249, 115, 22, 0.4)';
            for (let bx = 300; bx < 420; bx += 20) {
                for (let by = 160; by < 480; by += 30) {
                    if ((bx + by) % 40 === 0) ctx.fillRect(bx, by, 10, 16);
                }
            }

            // Layer 2: Metallic Parallax Stage Floor
            ctx.fillStyle = '#1c192c';
            ctx.fillRect(0, 520, canvas.width, canvas.height - 520);
            ctx.strokeStyle = '#f97316'; ctx.lineWidth = 3;
            ctx.beginPath(); ctx.moveTo(0, 520); ctx.lineTo(canvas.width, 520); ctx.stroke();

            if (gameState === 'COMBAT' || gameState === 'VS_TRANSITION') {
                p1.update(p2);
                p2.update(p1);
                p1.animBox.render(ctx);
                p2.animBox.render(ctx);

                document.getElementById('hud-p1-hp-fill').style.width = ((p1.health / p1.maxHealth) * 100) + '%';
                document.getElementById('hud-p2-hp-fill').style.width = ((p2.health / p2.maxHealth) * 100) + '%';
                document.getElementById('hud-p1-hp-text').innerText = p1.health + ' / ' + p1.maxHealth;
                document.getElementById('hud-p2-hp-text').innerText = p2.health + ' / ' + p2.maxHealth;
            }

            requestAnimationFrame(gameLoop);
        }

        window.onload = () => requestAnimationFrame(gameLoop);
    </script>
</body>
</html>
