        <!-- Combo Banner -->
        <div id="combo-banner" class="absolute top-4 left-6 bg-red-950/85 border-2 border-red-500 text-red-200 px-4 py-1 rounded-xl font-black text-sm tracking-widest hidden shadow-2xl animate-bounce z-40">
            EMERGENT STAGE COMBO | 15% DMG
        </div>
        
        <div class="absolute bottom-2 left-4 text-[10px] text-amber-500/90 font-mono pointer-events-none bg-black/70 px-2.5 py-1.5 rounded border border-amber-500/30 leading-relaxed">
            <div>ALIVE INFRASTRUCTURE: MULTI-LAYER PARALLAX | FLOCKING BIRDS | FLICKERING TORCHES</div>
            <div id="stage-telemetry">STAGE: THE COURTYARD (MOONLIT PEAKS & SWAYING FLORA)</div>
        </div>
    </main>

    <!-- TOUCH CONTROLS & ACTION DECK (15%) -->
    <footer class="w-full h-[15%] grid grid-cols-2 gap-2 z-50">
        <div class="glass-panel rounded-xl flex items-center justify-around px-2 py-1">
            <div class="relative w-20 h-20 bg-black/60 rounded-full border border-amberGlow/40 flex items-center justify-center shadow-inner">
                <div class="absolute top-1 text-amberGlow text-xs cursor-pointer" ontouchstart="setMove('up')" onmousedown="setMove('up')">▲</div>
