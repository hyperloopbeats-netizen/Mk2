            <button onclick="triggerAction('HP')" class="w-full h-10 bg-blue-950/70 hover:bg-blue-900 text-blue-300 border border-blue-500/60 rounded flex flex-col items-center justify-center text-[9px] font-extrabold shadow">HP</button>
            <button onclick="triggerAction('LK')" class="w-full h-10 bg-green-950/70 hover:bg-green-900 text-green-300 border border-green-500/60 rounded flex flex-col items-center justify-center text-[9px] font-bold shadow">LK</button>
            <button onclick="triggerAction('HK')" class="w-full h-10 bg-amber-950/70 hover:bg-amber-900 text-amber-300 border border-amber-500/60 rounded flex flex-col items-center justify-center text-[9px] font-bold shadow">HK</button>
            <button onclick="triggerAction('BLK')" class="w-full h-10 bg-zinc-800/80 hover:bg-zinc-700 text-zinc-300 border border-zinc-600 rounded flex flex-col items-center justify-center text-[9px] font-bold shadow">BLK</button>

            <button onclick="triggerAction('UPPER')" class="w-full h-9 bg-purple-950/70 hover:bg-purple-900 text-purple-300 border border-purple-500/60 rounded flex flex-col items-center justify-center text-[8px] font-bold">UPPER</button>
            <button onclick="triggerAction('SWEEP')" class="w-full h-9 bg-emerald-950/70 hover:bg-emerald-900 text-emerald-300 border border-emerald-500/60 rounded flex flex-col items-center justify-center text-[8px] font-bold">SWEEP</button>
            <button onclick="triggerAction('SPECIAL1')" id="btn-spec1" class="w-full h-9 bg-orange-950/80 hover:bg-orange-900 text-orange-300 border border-orange-500/60 rounded flex flex-col items-center justify-center text-[8px] font-bold">SPEAR</button>
            <button onclick="triggerAction('SPECIAL2')" id="btn-spec2" class="w-full h-9 bg-red-950/80 hover:bg-red-900 text-red-300 border border-red-500/60 rounded flex flex-col items-center justify-center text-[8px] font-bold">TELE</button>
            <button onclick="triggerAction('FATAL')" class="w-full h-9 bg-yellow-950/90 hover:bg-yellow-900 text-yellow-300 border border-yellow-500/60 rounded flex flex-col items-center justify-center text-[8px] font-bold animate-pulse">FATAL</button>
        </div>
    </footer>

    <!-- 4x4 PICTURE MESH ROSTER SELECT MODAL -->
    <div id="rosterModal" class="fixed inset-0 bg-black/92 backdrop-blur-md z-50 hidden flex flex-col items-center justify-center p-4">
        <div class="max-w-3xl w-full flex justify-between items-center mb-3">
            <div>
                <h2 class="text-xl font-black text-amberGlow tracking-wider">16 COMBATANTS MESH (4x4 MATRIX)[span_0](start_span)[span_0](end_span)</h2>
                <p class="text-[10px] text-zinc-400">Select fighter to enter the living stage ecosystem[span_1](start_span)[span_1](end_span)[span_2](start_span)[span_2](end_span)</p>
            </div>
            <button onclick="toggleRoster()" class="bg-zinc-800 text-zinc-300 px-4 py-1.5 rounded-lg text-xs font-bold border border-zinc-600">CLOSE</button>
        </div>
        <div id="rosterGrid" class="grid grid-cols-4 gap-3 max-w-3xl w-full max-h-[70vh] overflow-y-auto p-1"></div>
    </div>

    <!-- SCRIPT ENGINE: ALIVE PARALLAX & EMERGENT STAGE INFRASTRUCTURE -->
    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        function resizeCanvas() {
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        const AudioSys = {
            ctx: null,
            init() { if (!this.ctx) this.ctx = new (window.AudioContext || window.webkitAudioContext)(); },
            playTone(f1, f2, dur, type = 'sine') {
                try {
                    this.init();
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = type;
                    osc.frequency.setValueAtTime(f1, this.ctx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(f2, this.ctx.currentTime + dur);
                    gain.gain.setValueAtTime(0.4, this.ctx.currentTime);
                    gain.gain.linearRampToValueAtTime(0.001, this.ctx.currentTime + dur);
                    osc.connect(gain); gain.connect(this.ctx.destination);
                    osc.start(); osc.stop(this.ctx.currentTime + dur);
                } catch(e){}
            }
        };

        // Living Background & Parallax Ecosystem Manager
        class StageEcosystem {
            constructor() {
                this.cameraX = 0;
                this.time = 0;
                // Initialize Procedural Flock (Birds)
                this.birds = [];
                for (let i = 0; i < 8; i++) {
                    this.birds.push({
                        x: Math.random() * canvas.width,
                        y: Math.random() * (canvas.height * 0.3),
                        vx: Math.random() * 2 + 1,
                        vy: (Math.random() - 0.5) * 0.5,
                        size: Math.random() * 3 + 2
                    });
                }
                // Torch / Fire Particles
                this.torches = [
                    { x: 100, y: canvas.height * 0.45, flicker: 0 },
                    { x: canvas.width - 100, y: canvas.height * 0.45, flicker: 0 }
                ];
            }
            update(targetCamX) {
                this.time += 0.03;
                this.cameraX += (targetCamX - this.cameraX) * 0.1;

                // Update Bird Flock
                this.birds.forEach(b => {
                    b.x += b.vx;
                    b.y += b.vy + Math.sin(this.time + b.x) * 0.2;
                    if (b.x > canvas.width + 50) b.x = -50;
                });

                // Update Torch flickers
                this.torches.forEach(t => {
                    t.flicker = Math.sin(this.time * 8 + t.x) * 15 + Math.random() * 10;
                });
            }
            render(ctx) {
                const w = canvas.width;
                const h = canvas.height;
                const floorY = h * 0.7;

                // --- LAYER 0: DEEP BACKGROUND (Sky & Moon with Parallax) ---
                const skyGrad = ctx.createLinearGradient(0, 0, 0, floorY);
                skyGrad.addColorStop(0, '#111827');
                skyGrad.addColorStop(1, '#1e1b4b');
                ctx.fillStyle = skyGrad;
                ctx.fillRect(0, 0, w, floorY);

                // Glowing Moon with Parallax shift (-0.1x)
                const moonX = (w * 0.75) - (this.cameraX * 0.1);
                ctx.save();
                ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
                ctx.beginPath(); ctx.arc(moonX, h * 0.22, 45, 0, Math.PI * 2); ctx.fill();
                ctx.fillStyle = 'rgba(255, 255, 255, 0.15);';
                ctx.beginPath(); ctx.arc(moonX, h * 0.22, 70, 0, Math.PI * 2); ctx.fill();
                ctx.restore();

                // --- LAYER 1: DISTANT MOUNTAINS & ARCHITECTURE (-0.3x Parallax) ---
                const mX = - (this.cameraX * 0.3);
                ctx.fillStyle = '#312e81';
                ctx.beginPath();
                ctx.moveTo(mX - 100, floorY);
                ctx.lineTo(mX + w * 0.3, floorY - 120);
                ctx.lineTo(mX + w * 0.6, floorY - 60);
                ctx.lineTo(mX + w + 100, floorY);
                ctx.fill();

                // --- LAYER 2: MIDGROUND PILLARS, TORCHES & FLORA (-0.6x Parallax) ---
                const fgX = - (this.cameraX * 0.6);
                ctx.fillStyle = '#1e293b';
                ctx.fillRect(fgX + w * 0.2, floorY - 180, 40, 180);
                ctx.fillRect(fgX + w * 0.7, floorY - 180, 40, 180);

                // Render Flickering Torches & Dynamic Light Glow
                this.torches.forEach(t => {
                    const renderTorchX = t.x - (this.cameraX * 0.6);
                    // Torch Glow
                    const glow = ctx.createRadialGradient(renderTorchX, t.y, 5, renderTorchX, t.y, 60 + t.flicker);
                    glow.addColorStop(0, 'rgba(249, 115, 22, 0.8)');
                    glow.addColorStop(1, 'rgba(249, 115, 22, 0)');
                    ctx.fillStyle = glow;
                    ctx.beginPath(); ctx.arc(renderTorchX, t.y, 60 + t.flicker, 0, Math.PI * 2); ctx.fill();

                    // Flame Core
                    ctx.fillStyle = '#f97316';
                    ctx.beginPath();
                    ctx.arc(renderTorchX, t.y - 10, 8 + (t.flicker * 0.2), 0, Math.PI * 2);
                    ctx.fill();
                });

                // --- LAYER 3: BOID FLOCK (Birds flying across the sky) ---
                ctx.fillStyle = 'rgba(255, 255, 255, 0.7)';
                this.birds.forEach(b => {
                    ctx.save();
                    ctx.translate(b.x, b.y);
                    ctx.beginPath();
                    ctx.moveTo(-b.size, 0);
                    ctx.lineTo(0, -b.size * 0.5);
                    ctx.lineTo(b.size, 0);
                    ctx.lineTo(0, b.size * 0.3);
                    ctx.closePath();
                    ctx.fill();
                    ctx.restore();
                });

                // --- LAYER 4: STAGE FLOOR HORIZON ---
                ctx.strokeStyle = '#f97316';
                ctx.lineWidth = 3;
                ctx.beginPath();
                ctx.moveTo(0, floorY);
                ctx.lineTo(w, floorY);
                ctx.stroke();

                // Floor grid perspective lines
                ctx.strokeStyle = 'rgba(249, 115, 22, 0.12)';
                ctx.lineWidth = 1;
                for (let i = -w; i < w * 2; i += 50) {
                    ctx.beginPath();
                    ctx.moveTo(i + (this.cameraX * 0.9), floorY);
                    ctx.lineTo(i + (this.cameraX * 0.9) + (i - w * 0.5) * 0.5, h);
                    ctx.stroke();
                }
            }
        }

        const StageEco = new StageEcosystem();

        // Roster Database
        const RosterData = {
            'SCORPION': { realm: 'Netherrealm', color: '#c2410c', spec1: 'SPEAR', spec2: 'TELE', sound: [400, 80] },
            'SUB-ZERO': { realm: 'Earthrealm', color: '#0284c7', spec1: 'FREEZE', spec2: 'SLIDE', sound: [600, 200] },
            'SMOKE': { realm: 'Earthrealm', color: '#71717a', spec1: 'VAPOR', spec2: 'TELE', sound: [300, 80] },
            'RAIDEN': { realm: 'Heavens', color: '#eab308', spec1: 'BOLT', spec2: 'TORPEDO', sound: [700, 80] },
            'LIU KANG': { realm: 'Earthrealm', color: '#dc2626', spec1: 'FIREBALL', spec2: 'BICYCLE', sound: [500, 100] },
            'SONYA': { realm: 'Spec-Ops', color: '#22c55e', spec1: 'RINGS', spec2: 'KISS', sound: [450, 90] },
            'JOHNNY': { realm: 'Earthrealm', color: '#3b82f6', spec1: 'SHADOW', spec2: 'KICK', sound: [550, 110] },
            'NOOB': { realm: 'Netherrealm', color: '#a855f7', spec1: 'CLONE', spec2: 'PORTAL', sound: [250, 60] },
            'AIMIX': { realm: 'Cybernetic', color: '#f97316', spec1: 'Z-GATE', spec2: 'SYNTH', sound: [800, 100], isBoss: true },
            'REPTILE': { realm: 'Outworld', color: '#16a34a', spec1: 'ACID', spec2: 'CLOAK', sound: [450, 100] },
            'KUNG LAO': { realm: 'Earthrealm', color: '#2563eb', spec1: 'TOSS', spec2: 'DIVE', sound: [600, 150] },
            'KITANA': { realm: 'Edenia', color: '#3b82f6', spec1: 'FANS', spec2: 'SQUARE', sound: [650, 180] },
            'GORO': { realm: 'Outworld', color: '#ca8a04', spec1: 'QUAD', spec2: 'STOMP', sound: [150, 30], isBoss: true },
            'ROBOCOP': { realm: 'Detroit 2038', color: '#94a3b8', spec1: 'BURST', spec2: 'CANNON', sound: [300, 40] },
            'LEONARDO': { realm: 'New York Sewers', color: '#15803d', spec1: 'SLASH', spec2: 'SHELL', sound: [500, 120] },
            'SHANG': { realm: 'Outworld', color: '#d97706', spec1: 'SOUL', spec2: 'MORPH', sound: [350, 90] }
        };

        class ModularFighter {
            constructor(x, y, charKey, isCpu = false) {
                this.x = x; this.y = y; this.yBase = y;
                this.isCpu = isCpu;
                this.setChar(charKey);
            }
            setChar(charKey) {
                this.charKey = charKey;
                const d = RosterData[charKey];
                this.name = charKey;
                this.color = d.color;
                this.health = d.isBoss ? 350 : 250;
                this.maxHealth = this.health;
                this.facing = this.isCpu ? -1 : 1;
                this.levelY = 8; this.targetLevelY = 8;
                this.state = 'IDLE'; this.animTimer = 0;
                this.pose = {
                    head: { rot: 0, ox: 0, oy: -35 },
                    torso: { rot: 0, ox: 0, oy: -15 },
                    lArm: { rot: 0, ox: -12, oy: -20 },
                    rArm: { rot: 0, ox: 12, oy: -20 },
                    lLeg: { rot: 0, ox: -8, oy: 15 },
                    rLeg: { rot: 0, ox: 8, oy: 15 }
                };
                this.particles = [];
            }
            update() {
                const diff = this.targetLevelY - this.levelY;
                if (Math.abs(diff) > 0.01) this.levelY += diff * 0.3;
                this.animTimer += 0.1;
                const w = Math.sin(this.animTimer) * 2;
                if (this.state === 'IDLE') {
                    this.pose.torso.rot = w * 0.4;
                    this.pose.lArm.rot = -5 + w;
                    this.pose.rArm.rot = 5 - w;
                } else {
                    this.pose.rArm.rot = 55;
                }

                // Ballistic Fluid Physics & Floor Pooling
                const floorY = canvas.height * 0.7;
                this.particles.forEach((p, idx) => {
                    p.vx *= 0.98;
                    p.vy += 0.65;
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.y >= floorY) {
                        p.y = floorY;
                        if (!p.pooled) { p.pooled = true; p.vx = 0; p.vy = 0; }
                    }
                    p.life -= 0.012;
                    if (p.life <= 0) this.particles.splice(idx, 1);
                });
            }
            render(ctx, cameraX) {
                ctx.save();
                // Apply camera offset to world render coordinates
                const renderScreenX = this.x - cameraX;
                const ry = this.yBase - ((12 - this.levelY) * 4);
                ctx.translate(renderScreenX, ry);
                ctx.scale(this.facing, 1);

                ctx.fillStyle = 'rgba(0,0,0,0.5)';
                ctx.beginPath(); ctx.ellipse(0, 35, 22, 8, 0, 0, Math.PI * 2); ctx.fill();

                ['rLeg', 'lLeg', 'torso', 'head', 'rArm', 'lArm'].forEach(k => {
                    const p = this.pose[k];
                    ctx.save();
                    ctx.translate(p.ox, p.oy);
                    ctx.rotate((p.rot * Math.PI) / 180);
                    ctx.fillStyle = this.color; ctx.strokeStyle = '#000'; ctx.lineWidth = 2;
                    if (k === 'head') {
                        ctx.fillRect(-10, -14, 20, 18); ctx.strokeRect(-10, -14, 20, 18);
                    } else if (k === 'torso') {
                        ctx.fillRect(-14, -18, 28, 34); ctx.strokeRect(-14, -18, 28, 34);
                    } else {
                        ctx.fillRect(-5, -4, 10, 26); ctx.strokeRect(-5, -4, 10, 26);
                    }
                    ctx.restore();
                });
                ctx.restore();

                // Render Blood Particles
                this.particles.forEach(p => {
                    ctx.save();
                    ctx.translate(p.x - cameraX, p.y);
                    const speed = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
                    ctx.rotate(Math.atan2(p.vy, p.vx));

                    ctx.fillStyle = `rgba(185, 28, 28, ${Math.max(0, p.life)})`;
                    if (p.pooled) {
                        ctx.beginPath(); ctx.ellipse(0, 0, p.size * 1.8, p.size * 0.5, 0, 0, Math.PI * 2); ctx.fill();
                    } else {
                        const stretch = Math.min(3.0, 1.0 + speed * 0.15);
                        ctx.beginPath(); ctx.ellipse(0, 0, p.size * stretch, p.size * 0.8, 0, 0, Math.PI * 2); ctx.fill();
                    }
                    ctx.restore();
                });
            }
            spawnImpactBlood(px, py) {
                for(let i = 0; i < 24; i++) {
                    const angle = (Math.random() * Math.PI) - (Math.PI / 2);
                    const speed = (Math.random() * 12) + 6;
                    this.particles.push({
                        x: px, y: py,
                        vx: Math.cos(angle) * speed * this.facing,
                        vy: Math.sin(angle) * speed - 3,
                        size: Math.random() * 4 + 2,
                        life: 1.0,
                        pooled: false
                    });
                }
            }
        }

        const p1 = new ModularFighter(canvas.width * 0.3, canvas.height * 0.65, 'SCORPION');
        const p2 = new ModularFighter(canvas.width * 0.7, canvas.height * 0.65, 'SUB-ZERO', true);

        function buildRosterMesh() {
            const grid = document.getElementById('rosterGrid');
            grid.innerHTML = '';
            Object.keys(RosterData).forEach(key => {
                const d = RosterData[key];
                const card = document.createElement('div');
                card.className = "glass-panel p-2 rounded-xl border border-amber-500/30 hover:border-amber-400 cursor-pointer flex flex-col items-center justify-center transition-all group";
                card.innerHTML = `
                    <div class="w-14 h-14 rounded-lg bg-black/80 border border-amber-500/40 flex items-center justify-center overflow-hidden relative mb-1.5">
                        <canvas id="thumb-${key}" class="w-full h-full object-cover"></canvas>
                        <span class="absolute bottom-1 font-black text-xs text-white drop-shadow">${key[0]}</span>
                    </div>
                    <span class="text-[11px] font-black text-amber-400 tracking-wider">${key}</span>
                    <span class="text-[8px] text-zinc-400">${d.realm}</span>
                `;
                card.onclick = () => selectFighter(key);
                grid.appendChild(card);
                setTimeout(() => renderThumbnail(`thumb-${key}`, d.color), 50);
            });
        }

        function renderThumbnail(canvasId, hexColor) {
            const cvs = document.getElementById(canvasId);
            if (!cvs) return;
            const tCtx = cvs.getContext('2d');
            cvs.width = 56; cvs.height = 56;
            tCtx.fillStyle = '#09090b'; tCtx.fillRect(0, 0, 56, 56);
            tCtx.fillStyle = hexColor;
            tCtx.beginPath(); tCtx.arc(28, 24, 14, 0, Math.PI * 2); tCtx.fill();
            tCtx.fillStyle = '#ffffff';
            tCtx.fillRect(21, 20, 4, 3); tCtx.fillRect(31, 20, 4, 3);
        }

        buildRosterMesh();

        function toggleRoster() {
            document.getElementById('rosterModal').classList.toggle('hidden');
        }

        function selectFighter(charKey) {
            p1.setChar(charKey);
            document.getElementById('p1-label').innerText = `${charKey} [LEAD]`;
            document.getElementById('btn-spec1').innerText = RosterData[charKey].spec1;
            document.getElementById('btn-spec2').innerText = RosterData[charKey].spec2;
            updateUI();
            toggleRoster();
        }

        function updateUI() {
            document.getElementById('p1-hp-bar').style.width = `${(p1.health / p1.maxHealth) * 100}%`;
            document.getElementById('p2-hp-bar').style.width = `${(p2.health / p2.maxHealth) * 100}%`;
        }

        let comboCount = 0, comboTimer = null;
        function registerHit(dmg, txt) {
            comboCount++;
            p2.health = Math.max(0, p2.health - dmg);
            updateUI();
            const b = document.getElementById('combo-banner');
            b.innerText = `${comboCount} STAGE COMBO | ${txt} (${dmg} DMG)`;
            b.classList.remove('hidden');
            clearTimeout(comboTimer);
            comboTimer = setTimeout(() => { comboCount = 0; b.classList.add('hidden'); }, 2500);
            
            p2.spawnImpactBlood(p2.x, p2.y - 20);
        }

        function triggerAction(action) {
            AudioSys.playTone(400, 80, 0.3, 'sawtooth');
            p1.state = 'ATTACK';
            setTimeout(() => p1.state = 'IDLE', 300);

            if (action === 'LP' || action === 'HP') registerHit(12, 'STRIKE');
            else if (action === 'LK' || action === 'HK') {
                p1.targetLevelY = 3; setTimeout(() => p1.targetLevelY = 8, 400); registerHit(16, 'AERIAL KICK');
            } else if (action === 'UPPER') {
                p1.targetLevelY = 2; setTimeout(() => p1.targetLevelY = 8, 450); registerHit(20, 'UPPERCUT');
            } else if (action === 'SWEEP') {
                p1.targetLevelY = 12; setTimeout(() => p1.targetLevelY = 8, 400); registerHit(15, 'SWEEP');
            } else if (action === 'SPECIAL1') {
                p1.state = 'SPECIAL'; registerHit(22, RosterData[p1.charKey].spec1);
            } else if (action === 'SPECIAL2') {
                p1.state = 'SPECIAL'; p1.x = p2.x - (p1.facing * 40); registerHit(25, RosterData[p1.charKey].spec2);
            } else if (action === 'FATAL') {
                p1.state = 'SPECIAL'; registerHit(95, 'BRUTALITY FATALITY');
            }
        }

        function setMove(dir) {
            if (dir === 'left') p1.x -= 15;
            if (dir === 'right') p1.x += 15;
            if (dir === 'up') { p1.targetLevelY = 3; setTimeout(() => p1.targetLevelY = 8, 500); }
            if (dir === 'down') { p1.targetLevelY = 12; setTimeout(() => p1.targetLevelY = 8, 400); }
        }

        function gameLoop() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Calculate target camera center between P1 and P2 for smooth parallax tracking
            const midX = (p1.x + p2.x) * 0.5;
            const targetCamX = midX - (canvas.width * 0.5);

            // Update & Render Living Stage Ecosystem (Parallax Background Layers)
            StageEco.update(targetCamX);
            StageEco.render(ctx);

            // Update & Render Fighters with Camera Parallax Offset
            p1.update(); p2.update();
            p1.render(ctx, StageEco.cameraX);
            p2.render(ctx, StageEco.cameraX);

            updateUI();
            requestAnimationFrame(gameLoop);
        }
        requestAnimationFrame(gameLoop);
    </script>
</body>
</html>
