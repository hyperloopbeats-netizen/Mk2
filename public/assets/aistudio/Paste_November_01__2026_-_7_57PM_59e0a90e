            { id: 'REPTILE', name: 'REPTILE', icon: '🦎', color: '#16a34a', bio: 'Zaterran Assassin' },
            { id: 'KUNG_LAO', name: 'KUNG LAO', icon: '👒', color: '#475569', bio: 'Shaolin Monk' },
            { id: 'KITANA', name: 'KITANA', icon: '🪭', color: '#2563eb', bio: 'Edenian Princess' },
            { id: 'AIMIX', name: 'AIMIX', icon: '👑', color: '#f97316', bio: 'Soundwave Sovereign' },
            { id: 'SONYA', name: 'SONYA', icon: '🎖️', color: '#15803d', bio: 'Special Forces General' },
            { id: 'CAGE', name: 'JOHNNY CAGE', icon: '🕶️', color: '#0ea5e9', bio: 'Action Superstar' },
            { id: 'GORO', name: 'GORO', icon: '🥊', color: '#ea580c', bio: 'Shokan Prince' },
            { id: 'ROBOCOP', name: 'ROBOCOP', icon: '🤖', color: '#94a3b8', bio: 'Cybernetic Officer' },
            { id: 'LEONARDO', name: 'LEONARDO', icon: '🐢', color: '#0284c7', bio: 'Leader of the Turtles' },
            { id: 'RANDOM', name: 'RANDOM', icon: '❓', color: '#a1a1aa', bio: 'Select Mystery Fighter' },
            { id: 'LOCKED', name: 'LOCKED', icon: '🔒', color: '#3f3f46', bio: 'Unknown Combatant' }
        ];

        /* ==========================================================================
           3. 6-PART MODULAR BODY RENDERER & 12-LEVEL PARAMETRIC MOVEMENT BOX
           ========================================================================== */
        class SingleMovementBox {
            constructor(owner) {
                this.owner = owner;
                this.levelY = 8; // Default level 8 (Neutral Standing)
                this.microStep = 0; // 0: Frame A, 1: Frame B, 2: Frame C
                
                // Rotations (degrees) and translation offsets for the 6 modular parts
                this.pose = {
                    head:  { rot: 0, ox: 0, oy: -75 },
                    torso: { rot: 0, ox: 0, oy: -45 },
                    lArm:  { rot: 15, ox: -12, oy: -55 },
                    rArm:  { rot: -20, ox: 12, oy: -55 },
                    lLeg:  { rot: 10, ox: -8, oy: -20 },
                    rLeg:  { rot: -10, ox: 8, oy: -20 }
                };
            }

            // Hermite Bezier micro-interpolation calculation
            interpolatePose(targetLevel, targetPose, t) {
                // Ease factor
                const ease = t * t * (3 - 2 * t);
                
                // Vertical Level Interpolation (Level 12 = Ground, Level 1 = Apex airborne)
                const currentY = this.owner.yBase - (this.levelY * 7);
                const targetY  = this.owner.yBase - (targetLevel * 7);
                this.owner.y = currentY + (targetY - currentY) * ease;

                // Micro-Frame body part interpolation
                for (let part in this.pose) {
                    if (targetPose[part]) {
                        this.pose[part].rot += (targetPose[part].rot - this.pose[part].rot) * ease;
                        this.pose[part].ox  += (targetPose[part].ox  - this.pose[part].ox)  * ease;
                        this.pose[part].oy  += (targetPose[part].oy  - this.pose[part].oy)  * ease;
                    }
                }
            }

            render(ctx) {
                ctx.save();
                ctx.translate(this.owner.x, this.owner.y);
                if (this.owner.facing === -1) {
                    ctx.scale(-1, 1);
                }

                const primaryColor = this.owner.color || '#f59e0b';

                // Render 6 Sliced Body Parts in Layer Order: R_ARM -> R_LEG -> TORSO -> HEAD -> L_LEG -> L_ARM
                
                // 1. REAR ARM
                ctx.save();
                ctx.translate(this.pose.rArm.ox, this.pose.rArm.oy);
                ctx.rotate((this.pose.rArm.rot * Math.PI) / 180);
                ctx.fillStyle = '#71717a';
                ctx.fillRect(-4, 0, 8, 26); // Bicep/Forearm slice
                ctx.fillStyle = primaryColor;
                ctx.fillRect(-5, 14, 10, 8); // Gauntlet
                ctx.restore();

                // 2. REAR LEG
                ctx.save();
                ctx.translate(this.pose.rLeg.ox, this.pose.rLeg.oy);
                ctx.rotate((this.pose.rLeg.rot * Math.PI) / 180);
                ctx.fillStyle = '#27272a';
                ctx.fillRect(-6, 0, 11, 34); // Shin/Thigh slice
                ctx.fillStyle = primaryColor;
                ctx.fillRect(-6, 26, 12, 8); // Boot
                ctx.restore();

                // 3. TORSO
                ctx.save();
                ctx.translate(this.pose.torso.ox, this.pose.torso.oy);
                ctx.rotate((this.pose.torso.rot * Math.PI) / 180);
                ctx.fillStyle = '#18181b';
                ctx.fillRect(-14, -15, 28, 35); // Gi Body
                ctx.fillStyle = primaryColor;
                ctx.fillRect(-10, -15, 20, 35); // Yellow Ninja Vest Strap
                ctx.restore();

                // 4. HEAD
                ctx.save();
                ctx.translate(this.pose.head.ox, this.pose.head.oy);
                ctx.rotate((this.pose.head.rot * Math.PI) / 180);
                // Skull or Ninja Mask
                ctx.fillStyle = this.owner.isSkullHead ? '#fef08a' : primaryColor;
                ctx.beginPath();
                ctx.arc(0, -5, 12, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = '#09090b';
                ctx.fillRect(-8, -8, 16, 6); // Visor/Mask gap
                ctx.restore();

                // 5. LEAD LEG
                ctx.save();
                ctx.translate(this.pose.lLeg.ox, this.pose.lLeg.oy);
                ctx.rotate((this.pose.lLeg.rot * Math.PI) / 180);
                ctx.fillStyle = '#3f3f46';
                ctx.fillRect(-6, 0, 12, 34);
                ctx.fillStyle = primaryColor;
                ctx.fillRect(-7, 26, 13, 8);
                ctx.restore();

                // 6. LEAD ARM (WITH WEAPON / SPEAR RENDER)
                ctx.save();
                ctx.translate(this.pose.lArm.ox, this.pose.lArm.oy);
                ctx.rotate((this.pose.lArm.rot * Math.PI) / 180);
                ctx.fillStyle = '#a1a1aa';
                ctx.fillRect(-4, 0, 8, 26);
                ctx.fillStyle = primaryColor;
                ctx.fillRect(-5, 14, 10, 8); // Lead Gauntlet

                // Render Harpoon Spear if active
                if (this.owner.isSpearActive) {
                    ctx.strokeStyle = '#d4d4d8';
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.moveTo(0, 20);
                    ctx.lineTo(this.owner.spearReach, 20);
                    ctx.stroke();

                    // Spear Tip
                    ctx.fillStyle = '#ef4444';
                    ctx.beginPath();
                    ctx.moveTo(this.owner.spearReach, 15);
                    ctx.lineTo(this.owner.spearReach + 15, 20);
                    ctx.lineTo(this.owner.spearReach, 25);
                    ctx.fill();
                }
                ctx.restore();

                ctx.restore();
            }
        }

        /* ==========================================================================
           4. EXPANDED SCORPIO (SCORPION) CHARACTER CLASS
           ========================================================================== */
        class Character {
            constructor(id, name, color, x, facing) {
                this.id = id;
                this.name = name;
                this.color = color;
                this.x = x;
                this.yBase = 420;
                this.y = this.yBase;
                this.vx = 0;
                this.vy = 0;
                this.facing = facing; // 1: Right, -1: Left

                // Resources
                this.health = 250;
                this.maxHealth = 250;
                this.mana = 100;
                this.runMeter = 100;
                this.weaponCharges = 4;

                // State Machine
                this.state = 'IDLE'; // IDLE, WALK, CROUCH, JUMP, SPEAR, TELEPORT, HIT, FATALITY
                this.stateTimer = 0;
                this.isSkullHead = false;
                this.isSpearActive = false;
                this.spearReach = 0;

                // Single Movement Box Engine
                this.animBox = new SingleMovementBox(this);

                // Blood Particles Array
                this.bloodStains = [];
            }

            update(opponent) {
                this.stateTimer++;

                // Track opponent facing directional vector if not executing locked moves
                if (!['SPEAR', 'TELEPORT', 'FATALITY'].includes(this.state)) {
                    this.facing = this.x < opponent.x ? 1 : -1;
                }

                // Physics movement update
                this.x += this.vx;
                this.y += this.vy;

                // Stage Boundaries
                if (this.x < 60) this.x = 60;
                if (this.x > 1140) this.x = 1140;

                // Handle State Animations & Movement Box interpolations
                switch (this.state) {
                    case 'IDLE':
                        this.vx = 0;
                        const idleLevel = 8 + Math.sin(this.stateTimer * 0.1) * 0.3;
                        this.animBox.interpolatePose(idleLevel, {
                            head:  { rot: 0, ox: 0, oy: -75 },
                            torso: { rot: 0, ox: 0, oy: -45 },
                            lArm:  { rot: 20 + Math.sin(this.stateTimer * 0.1) * 5, ox: -12, oy: -55 },
                            rArm:  { rot: -20, ox: 12, oy: -55 }
                        }, 0.2);
                        break;

                    case 'WALK':
                        const walkCycle = Math.sin(this.stateTimer * 0.2);
                        this.animBox.interpolatePose(8, {
                            lLeg: { rot: walkCycle * 30, ox: -8, oy: -20 },
                            rLeg: { rot: -walkCycle * 30, ox: 8, oy: -20 }
                        }, 0.3);
                        break;

                    case 'CROUCH':
                        this.vx = 0;
                        this.animBox.interpolatePose(11, {
                            head:  { rot: 15, ox: 0, oy: -55 },
                            torso: { rot: 25, ox: 0, oy: -35 },
                            lLeg:  { rot: 60, ox: -10, oy: -15 },
                            rLeg:  { rot: 60, ox: 10, oy: -15 }
                        }, 0.4);
                        break;

                    case 'SPEAR':
                        this.vx = 0;
                        this.isSpearActive = true;
                        if (this.spearReach < 300) this.spearReach += 25;
                        this.animBox.interpolatePose(8, {
                            lArm: { rot: 90, ox: -5, oy: -55 },
                            torso: { rot: -10, ox: 0, oy: -45 }
                        }, 0.5);

                        // Hit Check for Spear
                        const spearTipX = this.x + (this.facing * (this.spearReach + 20));
                        if (Math.abs(spearTipX - opponent.x) < 40 && opponent.state !== 'HIT') {
                            opponent.takeDamage(20);
                            opponent.state = 'HIT';
                            audio.playHit(200, 'sawtooth');
                        }

                        if (this.stateTimer > 40) {
                            this.isSpearActive = false;
                            this.spearReach = 0;
                            this.state = 'IDLE';
                        }
                        break;

                    case 'TELEPORT':
                        if (this.stateTimer === 1) {
                            audio.playFlameSFX();
                        }
                        if (this.stateTimer === 15) {
                            // Phase behind opponent
                            this.x = opponent.x - (this.facing * 90);
                            this.facing *= -1;
                        }
                        // Flying horizontal kick interpolation (Level 4 Parametric lock)
                        this.animBox.interpolatePose(4, {
                            torso: { rot: 80, ox: 0, oy: -45 },
                            lLeg:  { rot: 0, ox: 0, oy: -20 },
                            rLeg:  { rot: 45, ox: 0, oy: -20 }
                        }, 0.5);

                        if (this.stateTimer > 30) {
                            this.state = 'IDLE';
                        }
                        break;

                    case 'FATALITY':
                        // Toasty Fire Breath Fatality Timeline
                        if (this.stateTimer === 10) {
                            this.isSkullHead = true; // Unmask revealing burning skull
                            audio.playFlameSFX();
                        }
                        if (this.stateTimer > 20 && this.stateTimer < 80) {
                            // Emit flame particles toward opponent
                            spawnBloodOrFlame(opponent.x, opponent.y - 40, '#f97316', 8);
                            opponent.health = Math.max(0, opponent.health - 2);
                        }
                        if (this.stateTimer === 85) {
                            opponent.state = 'HIT';
                            audio.playHit(80, 'square', 0.5);
                        }
                        break;

                    case 'HIT':
                        this.animBox.interpolatePose(9, {
                            head:  { rot: -30, ox: 0, oy: -70 },
                            torso: { rot: -20, ox: 0, oy: -40 }
                        }, 0.5);
                        if (this.stateTimer > 15) this.state = 'IDLE';
                        break;
                }
            }

            takeDamage(amount) {
                this.health = Math.max(0, this.health - amount);
                spawnBloodOrFlame(this.x, this.y - 50, '#dc2626', 15);
            }

            // Hitbox verification geometry
            getHitbox() {
                return {
                    x: this.x + (this.facing * 20),
                    y: this.y - 70,
                    w: 45,
                    h: 50
                };
            }
        }

        /* ==========================================================================
           5. BLOOD & FLAME PARTICLE SYSTEM
           ========================================================================== */
        const particles = [];
        function spawnBloodOrFlame(x, y, color, count = 10) {
            for (let i = 0; i < count; i++) {
                particles.push({
                    x: x,
                    y: y,
                    vx: (Math.random() - 0.5) * 8,
                    vy: (Math.random() - 0.8) * 6,
                    color: color,
                    size: Math.random() * 4 + 2,
                    life: 40
                });
            }
        }

        function updateAndRenderParticles(ctx) {
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.x += p.vx;
                p.y += p.vy;
                p.vy += 0.2; // Gravity
                p.life--;

                ctx.fillStyle = p.color;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fill();

                if (p.life <= 0) particles.splice(i, 1);
            }
        }

        /* ==========================================================================
           6. ENGINE STATE, MENU & COMBAT CONTROLLER
           ========================================================================== */
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        
        // Canvas Internal Resolution Set (16:9 1200x675)
        canvas.width = 1200;
        canvas.height = 675;

        let gameState = 'MENU'; // MENU, VS_TRANSITION, COMBAT
        let p1Cursor = 0;
        let p2Cursor = 1;
        let selectedP1 = ROBO_DATA = ROSTER[0];
        let selectedP2 = ROSTER[1];

        let p1 = new Character('SCORPIO', 'SCORPIO', '#f59e0b', 300, 1);
        let p2 = new Character('SUB_ZERO', 'SUB-ZERO', '#0ea5e9', 900, -1);

        // Build HTML Character Select Grid
        const rosterGridEl = document.getElementById('roster-grid');
        ROSTER.forEach((char, index) => {
            const tile = document.createElement('div');
            tile.id = `grid-tile-${index}`;
            tile.className = `glass-panel rounded-lg flex flex-col items-center justify-center p-1.5 cursor-pointer border-2 transition-all duration-150 ${index === 0 ? 'border-amber-500 glass-panel-gold' : 'border-transparent'}`;
            tile.innerHTML = `
                <span class="text-xl sm:text-2xl">${char.icon}</span>
                <span class="text-[9px] font-bold tracking-tighter mt-1 text-zinc-300">${char.name}</span>
            `;
            tile.onclick = () => selectCharacter(index);
            rosterGridEl.appendChild(tile);
        });

        function updateGridSelection() {
            ROSTER.forEach((_, idx) => {
                const el = document.getElementById(`grid-tile-${idx}`);
                if (el) {
                    if (idx === p1Cursor) {
                        el.className = 'glass-panel glass-panel-gold rounded-lg flex flex-col items-center justify-center p-1.5 border-2 border-amber-500 scale-105 z-10 shadow-lg';
                    } else {
                        el.className = 'glass-panel rounded-lg flex flex-col items-center justify-center p-1.5 border-2 border-transparent opacity-80';
                    }
                }
            });

            // Update Spotlight
            selectedP1 = ROSTER[p1Cursor];
            document.getElementById('p1-name').innerText = selectedP1.name;
            document.getElementById('p1-portrait-icon').innerText = selectedP1.icon;
            audio.playMenuTick();
        }

        function selectCharacter(index) {
            audio.init();
            p1Cursor = index;
            updateGridSelection();
            startMatchTransition();
        }

        function startMatchTransition() {
            gameState = 'VS_TRANSITION';
            audio.playHit(300, 'sine', 0.4);

            // Hide Menu Layer & Show HUD after 1.2s delay
            setTimeout(() => {
                document.getElementById('character-select-menu').classList.add('hidden');
                document.getElementById('combat-hud').classList.remove('hidden');
                gameState = 'COMBAT';
            }, 1200);
        }

        /* ==========================================================================
           7. INPUT POLLING & KEYBOARD / TOUCH LISTENERS
           ========================================================================== */
        const keys = {};
        window.addEventListener('keydown', e => {
            audio.init();
            keys[e.code] = true;

            if (gameState === 'MENU') {
                if (e.code === 'KeyD' || e.code === 'ArrowRight') { p1Cursor = (p1Cursor + 1) % ROSTER.length; updateGridSelection(); }
                if (e.code === 'KeyA' || e.code === 'ArrowLeft') { p1Cursor = (p1Cursor - 1 + ROSTER.length) % ROSTER.length; updateGridSelection(); }
                if (e.code === 'Enter' || e.code === 'Space') { startMatchTransition(); }
            } else if (gameState === 'COMBAT') {
                // Special Move Triggers for Scorpio
                if (e.code === 'KeyF') { p1.state = 'SPEAR'; p1.stateTimer = 0; audio.playSpearSFX(); }
                if (e.code === 'KeyT') { p1.state = 'TELEPORT'; p1.stateTimer = 0; }
                if (e.code === 'KeyK') { p1.state = 'FATALITY'; p1.stateTimer = 0; triggerAnnouncer('FATALITY'); }
            }
        });

        window.addEventListener('keyup', e => { keys[e.code] = false; });

        // Touch Button Mapping Binding
        const bindBtn = (id, onPress) => {
            const btn = document.getElementById(id);
            if (btn) {
                btn.addEventListener('touchstart', (e) => { e.preventDefault(); audio.init(); onPress(); });
                btn.addEventListener('click', () => { audio.init(); onPress(); });
            }
        };

        bindBtn('btn-left', () => { if (gameState === 'COMBAT') { p1.vx = -4; p1.state = 'WALK'; } });
        bindBtn('btn-right', () => { if (gameState === 'COMBAT') { p1.vx = 4; p1.state = 'WALK'; } });
        bindBtn('btn-down', () => { if (gameState === 'COMBAT') { p1.state = 'CROUCH'; } });
        bindBtn('btn-hp', () => { if (gameState === 'COMBAT') { p1.state = 'SPEAR'; p1.stateTimer = 0; audio.playSpearSFX(); } });
        bindBtn('btn-hk', () => { if (gameState === 'COMBAT') { p1.state = 'TELEPORT'; p1.stateTimer = 0; } });
        bindBtn('btn-wpn', () => { if (gameState === 'COMBAT') { p1.state = 'FATALITY'; p1.stateTimer = 0; triggerAnnouncer('TOASTY!'); } });

        function triggerAnnouncer(text) {
            const banner = document.getElementById('announcer-banner');
            const txt = document.getElementById('announcer-text');
            txt.innerText = text;
            banner.classList.remove('hidden');
            setTimeout(() => banner.classList.add('hidden'), 2500);
        }

        /* ==========================================================================
           8. MAIN GAME LOOP (60 FPS RENDERER)
           ========================================================================== */
        function gameLoop() {
            // Clear Stage Canvas
            ctx.fillStyle = '#09090b';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Draw Stage Arena Backdrop (Netherrealm Lair)
            ctx.fillStyle = '#18181b';
            ctx.fillRect(0, 480, canvas.width, 195); // Floor Ground
            ctx.strokeStyle = '#f59e0b';
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.moveTo(0, 480);
            ctx.lineTo(canvas.width, 480);
            ctx.stroke();

            if (gameState === 'COMBAT' || gameState === 'VS_TRANSITION') {
                // Update Character States & Physics
                p1.update(p2);
                p2.update(p1);

                // Render Characters via 6-Part Modular Engine
                p1.animBox.render(ctx);
                p2.animBox.render(ctx);

                // Render Blood & Flame Particles
                updateAndRenderParticles(ctx);

                // Update HUD Elements
                document.getElementById('hud-p1-hp-fill').style.width = `${(p1.health / p1.maxHealth) * 100}%`;
                document.getElementById('hud-p2-hp-fill').style.width = `${(p2.health / p2.maxHealth) * 100}%`;
                document.getElementById('hud-p1-hp-text').innerText = `${p1.health} / ${p1.maxHealth}`;
                document.getElementById('hud-p2-hp-text').innerText = `${p2.health} / ${p2.maxHealth}`;
            }

            requestAnimationFrame(gameLoop);
        }

        // Initialize Engine Loop
        window.onload = () => {
            updateGridSelection();
            requestAnimationFrame(gameLoop);
        };
    </script>
</body>
